{
  "name": "Immich Handoff",
  "short_name": "Handoff",
  "description": "Hand photos from one Immich account to another by tagging them.",
  "start_url": "../",
  "scope": "../",
  "display": "standalone",
  "background_color": "#0d0b20",
  "theme_color": "#0d0b20",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "media", "accept": ["image/*", "video/*", ".heic", ".heif", ".dng"] }] }
  }
}
