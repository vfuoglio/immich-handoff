package web

import (
	"fmt"
	"net/url"

	"github.com/vfuoglio/immich-handoff/internal/syncer"
)

// ServiceView is one service as the signed-in user takes part in it.
type ServiceView struct {
	Name     string
	Role     string // sender | receiver
	Tag      string // the tag the user adds (sender) or looks for (receiver)
	From     int    // number of senders
	To       int    // number of receivers
	CanLeave bool   // the person joined from this page, so can leave from it
	Paused   string // why the service cannot work right now, if so
	Copy     bool   // the signed-in sender chose to keep their originals (otherwise they are moved to their trash)
	Album    string // receiver: the album arrivals are put in, if the service has one
	CanWatch bool   // sender: joined from this page, so may link an album
	Watch    string // sender: the album linked to this service, whose photos are all handed over

	Hold       string // why this sender's photos are on hold (paused by the owner, or by themselves); empty: not
	MinePaused bool   // sender: they paused their own membership
	CanPause   bool   // sender: joined from this page, so may pause
	Limit      string // the daily limit for each sender ("20 photos and 500 MB a day"); empty: none
	Used       string // sender: how much of it they have used in the last day
	Waiting    string // sender: photos waiting because the limit was reached, and until when
	Stopped    bool   // receiver: the owner paused this service
}

// OfferView is a service the signed-in person is not part of yet, and what they can do about it.
type OfferView struct {
	Name   string
	Tag    string
	Owner  string // empty for services from the configuration
	State  string // join | request | pending | approved | declined
	Invite string // the invitation token the person arrived with, if any
}

// RequestView is someone waiting for the owner's decision.
type RequestView struct {
	ID, Name, Email string
}

// OwnedView is a service the signed-in person created.
type OwnedView struct {
	Name, Tag, Policy string
	Invite            string // invitation token; empty when the service is listed for everyone
	Broken            string // why the receiver key stopped working, if it did
	Album             string // the album arrivals are put in, if the service has one
	Requests          []RequestView
	Members           []MemberView
	Paused            bool // the owner paused it
	LimitPhotos       int  // daily cap per sender, 0: none
	LimitMB           int
}

// MemberView is a sender of a service the person owns.
type MemberView struct {
	Name  string
	State string // active | broken
	Copy  bool   // their originals are kept (otherwise moved to their trash)
	Paused  bool   // they paused their membership
	AtLimit bool   // they reached the service's daily limit
	Used    string // what they handed over in the last day, when the service has a limit
}

// BrokenView is a connection of the person that Immich rejected.
type BrokenView struct {
	Service, Note string
}

// ActivityView is one line of the activity log.
type ActivityView struct {
	When, Text string
}

// NeedAction is a button on a card in the "Needs you" strip.
type NeedAction struct {
	Label, Path, Vals string
	Confirm           string // asked before it runs; empty: no question
	Primary           bool
}

// NeedView is one thing that waits on the person: a request to approve, a connection to restore, a pause or a
// limit that holds photos back. Tone is the chip colour (bad, warn or empty).
type NeedView struct {
	Tone, Chip, Title, Text string
	Actions                 []NeedAction
}

// DayBar is one day of the week's chart.
type DayBar struct {
	Label string // "Mon"
	N     int
}

// NumbersView is the three numbers at the top of the Overview. Waiting only means something to a sender and Inbox to
// a receiver, so each is shown only to the people it is about.
type NumbersView struct {
	Loading          bool // the first paint: skeletons, until the page asks for the real numbers
	Sender, Receiver bool
	Waiting, Inbox   int
	Week             int
	Days             [7]DayBar
}

// GuideStep is one step of the first-run guide.
type GuideStep struct {
	Text string
	Done bool
}

// GuideView is the first-run guide, shown until it is finished or hidden.
type GuideView struct {
	Steps    []GuideStep
	Done     int
	NextStep string // what to do next, as the heading
}

// DashboardData is everything the main page shows.
type DashboardData struct {
	User     string
	Services []ServiceView
	Offers   []OfferView
	Owned    []OwnedView
	Invited  *OfferView // the service an invitation link leads to
	Orphaned []string   // services the person joined that their owner has since removed
	Broken   []BrokenView
	Activity []ActivityView
	TagsOff  bool // Tags are switched off in the person's Immich account, so they cannot add or see tags
	CanOffer bool // people may create services on this install
	Last     *syncer.RunInfo

	Headline   string // the greeting, e.g. "Hello, Alice."
	Needs      []NeedView
	ShowNumber bool       // there is something to count: the person takes part in a service
	Guide      *GuideView // nil: finished, hidden, or nowhere to remember it
}

templ Layout(title, user string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles": false}'/>
			if b := baseHref(ctx); b != "" {
				<base href={ b }/>
			}
			<title>{ title }</title>
			<link rel="icon" href="static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="static/app.css"/>
			<script src="static/theme.js"></script>
			<script src="static/htmx.min.js" defer></script>
			<script src="static/app.js" defer></script>
		</head>
		<body hx-headers='{"X-Requested-With": "immich-handoff"}'>
			<div class="wrap">
				<header class="bar">
					<div class="brand">
						<img src="static/favicon.svg" alt="" width="28" height="28"/>
						Immich Handoff
					</div>
					if user != "" {
						<div class="who">
							if isAdmin(ctx) {
								<a class="adminlink" href="admin">Admin</a>
							}
							<span id="live" class="live off" title="Live updates" role="img" aria-label="Live updates"></span>
							<button type="button" class="icon-btn" id="theme" aria-label="Dark theme" title="Switch between the light and the dark theme" aria-pressed="false">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17" ></path><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" stroke="none"></path></svg>
							</button>
							<span class="avatar" aria-hidden="true">{ initial(user) }</span>
							<span>{ user }</span>
						</div>
					}
				</header>
				<main>
					{ children... }
				</main>
				<footer>Photos you tag in Immich are handed over automatically.</footer>
			</div>
		</body>
	</html>
}

// TagsNotice offers to switch Tags on, which Immich has off by default and which everyone taking part needs.
templ TagsNotice() {
	<div class="card notice" id="tags-notice">
		<h3>Tags are switched off in your Immich account</h3>
		<p class="meta">Tags are how photos are handed over, and how you find what arrived. While they are off you cannot add tags in Immich or see them, so the rest of this page is switched off until you turn them on. Turning them on changes one setting in your Immich account, the same as Account Settings, Features, Tags.</p>
		<p class="row"><button class="primary" hx-post="preferences/tags" hx-target="#tags-notice" hx-swap="innerHTML" hx-disabled-elt="this">Turn on Tags</button></p>
	</div>
}

templ Dashboard(d DashboardData) {
	@Layout("Immich Handoff", d.User) {
		<p id="flash" class="toast" role="status" aria-live="polite"></p>
		if d.TagsOff {
			@TagsNotice()
		}
		<div id="gated" { gate(d.TagsOff)... }>
		if d.Invited != nil {
			<h2>You are invited</h2>
			@OfferCard(*d.Invited)
		}
		<h1>{ d.Headline }</h1>
		<p class="lead">{ needsLine(len(d.Needs)) } Tag a photo in the Immich app and it is handed over within seconds.</p>
		<h2>Needs you <span class="count-badge">{ fmt.Sprint(len(d.Needs)) }</span></h2>
		if len(d.Needs) == 0 {
			<div class="card need allclear"><b><span class="chip ok">All clear</span> Nothing needs you</b><p class="meta">New requests and problems appear here first.</p></div>
		}
		<div class="needs">
			for _, n := range d.Needs {
				@NeedCard(n)
			}
		</div>
		if d.ShowNumber {
			<h2>This week</h2>
			@Numbers(NumbersView{Loading: true})
		}
		if d.Guide != nil {
			@Guide(*d.Guide)
		}
		<h2>Your services</h2>
		if len(d.Services) == 0 {
			<div class="card empty">You do not take part in any service yet.</div>
		}
		for _, s := range d.Services {
			@ServiceCard(s)
		}
		if len(d.Owned) > 0 {
			<h2>Services you offer</h2>
			for _, o := range d.Owned {
				@OwnedCard(o)
			}
		}
		if len(d.Offers) > 0 {
			<h2>Services you can send to</h2>
			for _, o := range d.Offers {
				@OfferCard(o)
			}
		}
		if d.CanOffer {
			<details class="offer">
				<summary>Offer a service of your own</summary>
				@OfferForm()
			</details>
		}
		if len(d.Activity) > 0 {
			<h2>Recent events</h2>
			<section class="card" aria-label="Recent events">
				<ul class="events">
					for _, a := range d.Activity {
						<li><span class="meta">{ a.When }</span> { a.Text }</li>
					}
				</ul>
			</section>
		}
		if len(d.Services) > 0 {
			<h2>Activity</h2>
			@LastRun(d.Last)
			<p class="row">
				<button class="primary" hx-post="sync" hx-target="#synctoast" hx-swap="innerHTML" hx-disabled-elt="this">Sync now</button>
				<span id="synctoast" class="toast" aria-live="polite"></span>
			</p>
		}
		</div>
	}
}

// WatchBox is where a sender links one of their albums to a service, so everything in it is handed over.
templ WatchBox(s ServiceView) {
	<div class="watch">
		if s.Watch != "" {
			<p class="meta">Everything in your album <strong>{ s.Watch }</strong> is handed over to this service, now and whatever you add to it later. The app looks at it every few minutes, and each photo is handed over once.</p>
		}
		<p class="row">
			if s.Watch != "" {
				<button hx-post="services/album/stop" hx-vals={ vals("service", s.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">Stop handing over this album</button>
			}
			<button hx-get={ "fragments/albums?service=" + url.QueryEscape(s.Name) } hx-target="next .albumform" hx-swap="innerHTML" hx-disabled-elt="this">
				if s.Watch != "" {
					Link a different album
				} else {
					Hand over a whole album
				}
			</button>
		</p>
		<div class="albumform"></div>
	</div>
}

// AlbumChoice is the form that follows: the sender's own albums, and a button to link the chosen one.
templ AlbumChoice(service string, albums []AlbumOption, copies bool) {
	if len(albums) == 0 {
		<p class="meta">You have no albums of your own yet. Make one in Immich, then come back.</p>
	} else {
		<form class="card" hx-post="services/album" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button" hx-confirm={ albumConfirm(service, copies) }>
			<input type="hidden" name="service" value={ service }/>
			<div class="field">
				<label for="watch-album">Album to hand over to { service }</label>
				<select id="watch-album" name="album">
					for _, a := range albums {
						<option value={ a.ID }>{ a.Label }</option>
					}
				</select>
			</div>
			<p class="meta">Everything in it, and whatever you add later, goes to { service }. { originalsNote(copies) } Only photos you own are used.</p>
			<p class="row"><button class="primary" type="submit">Hand over this album</button></p>
		</form>
	}
}

templ ServiceCard(s ServiceView) {
	<article class="card">
		<header>
			<h3>{ s.Name }</h3>
			<span class={ "chip", roleClass(s.Role) }>{ roleLabel(s.Role) }</span>
		</header>
		if s.Paused != "" {
			<p class="meta"><span class="chip warn">Paused</span> { s.Paused } Photos stay where they are until it is fixed.</p>
		}
		if s.Hold != "" {
			<p class="meta"><span class="chip warn">Paused</span> { s.Hold } Photos tagged meanwhile stay tagged and are handed over when it resumes.</p>
		}
		if s.Stopped {
			<p class="meta"><span class="chip warn">Paused</span> You paused this service: nothing is handed over to you until you resume it (on its card under Services you offer).</p>
		}
		if s.Limit != "" && s.Role == "sender" {
			<p class="meta">The owner limits each sender to { s.Limit }. { s.Used }</p>
		}
		if s.Waiting != "" {
			<p class="meta"><span class="chip warn">Waiting</span> { s.Waiting }</p>
		}
		<p class="meta">
			if s.Role == "sender" {
				Add the tag <code class="tag">{ s.Tag }</code> to a photo in Immich to send it. { originalsNote(s.Copy) }
			} else if s.Album != "" {
				Photos arrive in the album <strong>{ s.Album }</strong>.
			} else {
				Photos arrive tagged <code class="tag">{ s.Tag }</code>.
			}
			{ fmt.Sprintf(" %d %s, %d %s.", s.From, plural(s.From, "sender", "senders"), s.To, plural(s.To, "receiver", "receivers")) }
		</p>
		if s.Role == "sender" && s.CanWatch {
			@WatchBox(s)
		}
		if s.CanPause {
			<p class="row">
				if s.MinePaused {
					<button class="primary" hx-post="pause" hx-vals={ pauseVals(s.Name, false) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">Resume sending</button>
				} else {
					<button hx-post="pause" hx-vals={ pauseVals(s.Name, true) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Pause sending to this service? Photos you tag stay tagged and are handed over when you resume.">Pause sending</button>
				}
			</p>
		}
		if s.CanLeave {
			<p class="row">
				<button hx-post="leave" hx-vals={ `{"service":"` + s.Name + `"}` } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ "Leave " + s.Name + "? Your Immich API key for it and its workflow will be deleted." }>Leave</button>
			</p>
		}
		<div class="stats">
			<div class="stat" hx-get={ "fragments/count?service=" + s.Name + "&role=" + s.Role } hx-trigger="load, handoff:run from:body" hx-swap="innerHTML">
				<span class="skeleton"></span>
				<small>{ countLabel(s.Role) }</small>
			</div>
		</div>
	</article>
}

templ Count(n int, role string, thumbs []string) {
	{ fmt.Sprint(n) }
	<small>{ countLabel(role) }</small>
	if len(thumbs) > 0 {
		<span class="thumbs">
			for _, t := range thumbs {
				<img src={ templ.SafeURL(t) } alt="" loading="lazy" width="56" height="56"/>
			}
		</span>
	}
}

templ LastRun(info *syncer.RunInfo) {
	<section id="lastrun" class="card" hx-get="fragments/lastrun" hx-trigger="handoff:run from:body" hx-swap="outerHTML" aria-live="polite">
		if info == nil {
			<p class="meta">No run yet since the app started.</p>
		} else {
			<header>
				<h3>Last run</h3>
				<span class="meta">{ info.Finished.Format("2 Jan 15:04:05") } · { reasonLabel(info.Reason) }</span>
			</header>
			<div class="row">
				<span class="chip ok">{ fmt.Sprint(info.Counts.Imported) } handed over</span>
				<span class="chip">{ fmt.Sprint(info.Counts.Duplicate) } already there</span>
				<span class={ "chip", warnIf(info.Counts.Refused > 0) }>{ fmt.Sprint(info.Counts.Refused) } refused</span>
				<span class={ "chip", badIf(info.Counts.Errors > 0) }>{ fmt.Sprint(info.Counts.Errors) } errors</span>
				if info.Counts.DryRun > 0 {
					<span class="chip">{ fmt.Sprint(info.Counts.DryRun) } dry-run</span>
				}
			</div>
			if info.Error != "" {
				<p class="meta">{ info.Error }</p>
			}
		}
	</section>
}

templ Notice(title, text string, bad bool) {
	@Layout(title, "") {
		<div class={ "card", "notice", badClass(bad) }>
			<h1>{ title }</h1>
			<p class="lead">{ text }</p>
		</div>
	}
}

templ OfferCard(o OfferView) {
	<article class="card">
		<header>
			<h3>{ o.Name }</h3>
			<span class={ "chip", offerChip(o.State) }>{ offerLabel(o.State) }</span>
		</header>
		<p class="meta">
			Send photos by adding the tag <code class="tag">{ o.Tag }</code> to them in Immich.
			if o.Owner != "" {
				{ " Offered by " + o.Owner + "." }
			}
		</p>
		if o.State == "join" || o.State == "approved" || o.State == "request" {
			<p class="row">
				switch o.State {
					case "join", "approved":
						<span class="meta q">What should happen to your originals?</span>
						<button class="primary" hx-post="join" hx-vals={ valsJoin(o.Name, o.Invite, "copy") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ joinConfirm(o.Name, o.Tag, true) }>
							{ joinLabel(o.State, true) }
						</button>
						<button hx-post="join" hx-vals={ valsJoin(o.Name, o.Invite, "move") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ joinConfirm(o.Name, o.Tag, false) }>
							{ joinLabel(o.State, false) }
						</button>
					case "request":
						<button class="primary" hx-post="ask" hx-vals={ valsJoin(o.Name, o.Invite, "") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">Ask to join</button>
				}
			</p>
		}
	</article>
}

templ OwnedCard(o OwnedView) {
	<article class="card">
		<header>
			<h3>{ o.Name }</h3>
			<span class="chip">{ policyLabel(o.Policy) }</span>
			if o.Paused {
				<span class="chip warn">Paused</span>
			}
		</header>
		<p class="meta">You receive the photos senders tag <code class="tag">{ o.Tag }</code>. Nobody can see the key the app uses for your account.</p>
		if o.Album != "" {
			<p class="meta">What arrives is put in the album <strong>{ o.Album }</strong> in your Immich account, made when the first photo comes if you do not have it, instead of being tagged inbox.</p>
		}
		if o.Broken != "" {
			<p class="meta"><span class="chip bad">Disconnected</span> { o.Broken } Senders are paused until you reconnect (the button is under Needs you, above).</p>
		}
		if len(o.Members) > 0 {
			<p class="meta">
				Senders:
				for _, m := range o.Members {
					<span class={ "chip", memberChip(m.State) }>{ m.Name }{ memberSuffix(m.State, m.Copy) }{ pausedSuffix(m.Paused) }</span>
					if m.Used != "" {
						<span class="meta">{ m.Used }</span>
					}
				}
			</p>
		}
		<form class="row" hx-post="services/limits" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
			<input type="hidden" name="service" value={ o.Name }/>
			<label>Photos per sender per day <input name="photos" type="number" min="0" max="1000000" value={ fmt.Sprint(o.LimitPhotos) } class="narrow"/></label>
			<label>MB per sender per day <input name="mb" type="number" min="0" max="1000000" value={ fmt.Sprint(o.LimitMB) } class="narrow"/></label>
			<button type="submit">Save limits</button>
			<small class="meta">0 means no limit. Photos over the limit wait, tagged, until the day moves on.</small>
		</form>
		if len(o.Requests) > 0 {
			<p class="meta"><span class="chip warn">{ fmt.Sprint(len(o.Requests)) } waiting</span> Approve or decline them under Needs you, above.</p>
		}
		if o.Invite != "" {
			<div class="field">
				<label for={ "inv-" + o.Name }>Invitation link (only people with it can find this service)</label>
				<div class="row">
					<input id={ "inv-" + o.Name } class="invite" readonly data-invite={ o.Invite }/>
					<button type="button" class="copy">Copy</button>
					<button hx-post="services/invite" hx-vals={ vals("service", o.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="The current link will stop working. Continue?">New link</button>
				</div>
			</div>
		}
		<p class="row">
			if o.Paused {
				<button class="primary" hx-post="services/pause" hx-vals={ pauseVals(o.Name, false) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">Resume service</button>
			} else {
				<button hx-post="services/pause" hx-vals={ pauseVals(o.Name, true) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Pause this service? Nothing is handed over to you, and photos senders tag stay tagged, until you resume it.">Pause service</button>
			}
			if o.Invite != "" {
				<button hx-post="services/visibility" hx-vals={ visVals(o.Name, "listed") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">List for everyone</button>
			} else {
				<button hx-post="services/visibility" hx-vals={ visVals(o.Name, "invite") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">Make invitation-only</button>
			}
			<button hx-post="services/delete" hx-vals={ vals("service", o.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ "Delete " + o.Name + "? Its receiver key is removed from your Immich account and senders stop handing photos to you." }>Delete service</button>
		</p>
	</article>
}

templ OfferForm() {
	<form class="card" hx-post="services" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button" hx-confirm="Creating a service makes an API key named for it in your Immich account. The app uses it to upload the photos senders hand to you. Nobody can see the key.">
		<p class="meta">Others can then send you photos by tagging them. You decide who may send; each sender decides what happens to their own originals.</p>
		<div class="field">
			<label for="svc-name">Service name</label>
			<input id="svc-name" name="name" required minlength="2" maxlength="40" placeholder="Holiday 2026"/>
		</div>
		<div class="field">
			<label for="svc-tag">Tag senders add</label>
			<input id="svc-tag" name="tag" required maxlength="64" placeholder="holiday"/>
		</div>
		<div class="field">
			<label for="svc-vis">Who can find it</label>
			<select id="svc-vis" name="visibility">
				<option value="listed">Everyone on this Immich server</option>
				<option value="invite">Only people I send a link to</option>
			</select>
		</div>
		<details>
			<summary class="meta">More options</summary>
			<div class="field">
				<label for="svc-inbox">Tag put on what arrives (default: inbox)</label>
				<input id="svc-inbox" name="inbox" maxlength="64" placeholder="inbox"/>
			</div>
			<div class="field">
				<label for="svc-album">Put what arrives in this album (optional, instead of the inbox tag)</label>
				<input id="svc-album" name="album" maxlength="100" placeholder="Holiday 2026"/>
				<small class="meta">An album of yours with that name; it is made if you do not have one. The key the app uses then also gets permission to find, create and add to albums.</small>
			</div>
			<div class="field">
				<label for="svc-expiry">Days before an unfiled photo loses that tag (default: 30)</label>
				<input id="svc-expiry" name="expiry" type="number" min="1" max="3650" placeholder="30"/>
			</div>
			<div class="field">
				<label for="svc-lphotos">Most photos each sender may hand over in a day (optional)</label>
				<input id="svc-lphotos" name="photos" type="number" min="0" max="1000000" placeholder="no limit"/>
			</div>
			<div class="field">
				<label for="svc-lmb">Most megabytes each sender may hand over in a day (optional)</label>
				<input id="svc-lmb" name="mb" type="number" min="0" max="1000000" placeholder="no limit"/>
				<small class="meta">Photos over a limit wait, tagged, until the day moves on. You can change this later.</small>
			</div>
		</details>
		<div class="field">
			<label for="svc-policy">Who may send</label>
			<select id="svc-policy" name="policy">
				<option value="approval">People I approve</option>
				<option value="open">Anyone on this Immich server</option>
			</select>
		</div>
		<p class="row"><button class="primary" type="submit">Create service</button></p>
	</form>
}
// AdminData is everything the administrator's page shows.
type AdminData struct {
	User     string
	Services []AdminServiceView
	Leftover []AdminMemberView
	Activity []AdminActivityView
	SelfOn   bool // people can join from the page, so there is a store to remove from
}

type AdminServiceView struct {
	Name, Tag, Owner, Policy, Album string
	InviteOnly, Copy, FromConfig    bool
	Paused                          bool
	Limit                           string
	Receivers                       int
	Broken                          string
	Members                         []AdminMemberView
}

type AdminMemberView struct {
	LinkID, Name, Email, State, Note, Album string
	Copy, FromConfig                        bool
	Paused                                  bool
}

type AdminActivityView struct{ When, Service, Text string }

templ AdminPage(d AdminData) {
	@Layout("Immich Handoff: admin", d.User) {
		<p id="flash" class="toast" role="status" aria-live="polite"></p>
		<h1>Everything on this server</h1>
		<p class="lead">Every service, who offers it, who sends to it, and whether the connections work. <a href="./">Back to your own page</a></p>
		<p class="meta">Removing something here makes the app forget it and stop handing photos over. It cannot delete anyone's API key: Immich lets only the owner of a key delete it, so the key stays in that person's account until they delete it, and they are told so on their page. Photos are never touched.</p>
		<h2>Check the connections</h2>
		<p class="row">
			<button class="primary" hx-post="admin/check" hx-target="#checkresult" hx-swap="innerHTML" hx-disabled-elt="this" hx-indicator="#checkresult">Check now</button>
			<span class="meta">The same check as <code>immich-handoff doctor</code>. It only reads.</span>
		</p>
		<pre id="checkresult" class="card checkresult" aria-live="polite"></pre>
		<h2>Services</h2>
		if len(d.Services) == 0 {
			<div class="card empty">There are no services yet.</div>
		}
		for _, s := range d.Services {
			@AdminServiceCard(s, d.SelfOn)
		}
		if len(d.Leftover) > 0 {
			<h2>Waiting to clean up</h2>
			<p class="meta">Their service was removed. They still hold a key and a workflow in Immich and see a Clean up button on their page. Nothing is handed over for them.</p>
			<section class="card">
				<ul class="events">
					for _, m := range d.Leftover {
						<li>{ m.Name } <span class="meta">{ m.Email }</span></li>
					}
				</ul>
			</section>
		}
		if len(d.Activity) > 0 {
			<h2>Recent events</h2>
			<section class="card" aria-label="Recent events">
				<ul class="events">
					for _, a := range d.Activity {
						<li><span class="meta">{ a.When }</span> { a.Text }</li>
					}
				</ul>
			</section>
		}
	}
}

templ AdminServiceCard(s AdminServiceView, removable bool) {
	<article class="card">
		<header>
			<h3>{ s.Name }</h3>
			<span class="chip">{ adminPolicy(s.Policy) }</span>
			if s.InviteOnly {
				<span class="chip">Invitation only</span>
			}
			if s.FromConfig {
				<span class="chip">From configuration</span>
			}
			if s.Broken != "" {
				<span class="chip bad">Disconnected</span>
			}
			if s.Paused {
				<span class="chip warn">Paused</span>
			}
		</header>
		<p class="meta">
			Tag <code class="tag">{ s.Tag }</code>.
			if s.Limit != "" {
				Limit per sender: { s.Limit }.
			}
			if s.Owner != "" {
				Offered by { s.Owner }.
			}
			{ fmt.Sprint(s.Receivers) } { plural(s.Receivers, "receiver", "receivers") }.
			if s.Copy {
				Originals are kept.
			} else {
				Originals are moved to the sender's trash.
			}
			if s.Album != "" {
				Arrivals go to the album <strong>{ s.Album }</strong>.
			}
		</p>
		if s.Broken != "" {
			<p class="meta"><span class="chip bad">Disconnected</span> { s.Broken }</p>
		}
		if len(s.Members) == 0 {
			<p class="meta">No senders yet.</p>
		}
		<ul class="events">
			for _, m := range s.Members {
				<li>
					<span class={ "chip", memberChip(m.State) }>{ m.Name }</span>
					if m.Email != "" {
						<span class="meta">{ m.Email }</span>
					}
					<span class="meta">{ memberSuffix(m.State, m.Copy) }{ pausedSuffix(m.Paused) }</span>
					if m.Album != "" {
						<span class="meta">album { m.Album }</span>
					}
					if m.FromConfig {
						<span class="meta">from configuration</span>
					}
					if m.Note != "" {
						<br/><span class="meta">{ m.Note }</span>
					}
					if m.LinkID != "" && removable {
						<button hx-post="admin/members/remove" hx-vals={ vals("link", m.LinkID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ "Remove " + m.Name + " from " + s.Name + "? The app stops handing over their photos. Their API key stays in their Immich account until they delete it; they are told on their page." }>Remove</button>
					}
				</li>
			}
		</ul>
		if !s.FromConfig && removable {
			<p class="row">
				<button hx-post="admin/services/remove" hx-vals={ vals("service", s.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ "Remove the service " + s.Name + "? Nothing is handed over any more. The owner's receiver key stays in their Immich account until they delete it; members and owner are told." }>Remove this service</button>
			</p>
		}
	</article>
}

// NeedCard is one card of the "Needs you" strip.
templ NeedCard(n NeedView) {
	<article class={ "card", "need", n.Tone }>
		<b><span class={ "chip", n.Tone }>{ n.Chip }</span> { n.Title }</b>
		<p class="meta">{ n.Text }</p>
		if len(n.Actions) > 0 {
			<p class="row">
				for _, a := range n.Actions {
					if a.Confirm != "" {
						<button class={ primaryIf(a.Primary) } hx-post={ a.Path } hx-vals={ a.Vals } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ a.Confirm }>{ a.Label }</button>
					} else {
						<button class={ primaryIf(a.Primary) } hx-post={ a.Path } hx-vals={ a.Vals } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ a.Label }</button>
					}
				}
			</p>
		}
	</article>
}

// Numbers is the section of three numbers and the week's chart. It asks for itself again whenever a pass finishes.
templ Numbers(n NumbersView) {
	<section id="numbers" class="numbers" hx-get="fragments/numbers" hx-trigger="load, handoff:run from:body" hx-swap="outerHTML" aria-live="polite">
		<div class="kpis">
			<article class="card kpi wide">
				<span class="kpi-label">Handed over, last 7 days</span>
				<span class="num">
					if n.Loading {
						<span class="skeleton"></span>
					} else {
						{ fmt.Sprint(n.Week) }
					}
				</span>
				if !n.Loading {
					<svg class="spark" viewBox="0 0 300 56" preserveAspectRatio="none" role="img" aria-label={ sparkLabel(n.Days) }>
						<defs>
							<linearGradient id="sparkfill" x1="0" x2="0" y1="0" y2="1">
								<stop offset="0" stop-color="currentColor" stop-opacity=".35"></stop>
								<stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
							</linearGradient>
						</defs>
						<path d={ sparkArea(n.Days) } fill="url(#sparkfill)"></path>
						<path class="spark-line" d={ sparkLine(n.Days) } fill="none"></path>
						<circle class="spark-dot" cx={ sparkEndX() } cy={ sparkEndY(n.Days) } r="4.5"></circle>
					</svg>
					<ol class="days">
						for _, d := range n.Days {
							<li><b>{ fmt.Sprint(d.N) }</b><span>{ d.Label }</span></li>
						}
					</ol>
					if n.Week == 0 {
						<span class="sub">Nothing handed over yet this week.</span>
					}
				}
			</article>
			if n.Sender || n.Loading {
				<article class="card kpi">
					<span class="kpi-label">Waiting to go</span>
					<span class="num">
						if n.Loading {
							<span class="skeleton"></span>
						} else {
							{ fmt.Sprint(n.Waiting) }
						}
					</span>
					<span class="sub">tagged, still to be handed over</span>
				</article>
			}
			if n.Receiver || n.Loading {
				<article class="card kpi">
					<span class="kpi-label">In your inbox</span>
					<span class="num">
						if n.Loading {
							<span class="skeleton"></span>
						} else {
							{ fmt.Sprint(n.Inbox) }
						}
					</span>
					<span class="sub">arrived and not yet filed</span>
				</article>
			}
		</div>
	</section>
}

// Guide is the first-run guide: a ring that fills as the steps are done.
templ Guide(g GuideView) {
	<h2>Get started</h2>
	<section class="card guide" aria-label="Getting started">
		<div class={ "ring", fmt.Sprintf("r%d", g.Done) } role="img" aria-label={ fmt.Sprintf("%d of %d steps done", g.Done, len(g.Steps)) }>
			<span>{ fmt.Sprintf("%d/%d", g.Done, len(g.Steps)) }</span>
		</div>
		<div>
			<h3>{ g.NextStep }</h3>
			<ol class="steps">
				for _, s := range g.Steps {
					<li class={ doneIf(s.Done) }><span class="dot" aria-hidden="true">{ tickIf(s.Done) }</span> { s.Text }</li>
				}
			</ol>
			<p class="row"><button hx-post="guide/dismiss" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">Hide this guide</button></p>
		</div>
	</section>
}
