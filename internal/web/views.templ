package web

import (
	"fmt"
	"net/url"

	"github.com/vfuoglio/immich-handoff/internal/syncer"
)

// PushView is the person's "Notifications on this device" card.
type PushView struct {
	Available bool
	Key       string // the public key a browser subscribes with
	Devices   []PushDeviceView
}

// PushDeviceView is one of the person's devices.
type PushDeviceView struct {
	ID, Label, Mode string
	Added, LastOK   string // already written for the reader; LastOK is empty until a push got through
}

// FrameView is one of the person's frames.
type FrameView struct {
	ID, Name, Album, Token string
	Seconds                int
	Ends                   string // when the link stops, "" for never
	Ended                  bool
}

// MailView is the person's "Email me" card.
type MailView struct {
	Available bool // this install can write to people
	On        bool
	Mode      string // all or needs
	Email     string
}

// ServiceView is one service as the signed-in user takes part in it.
type ServiceView struct {
	Name     string
	Role     string // sender | receiver
	Tag      string // the tag the user adds (sender) or looks for (receiver)
	From     int    // number of senders
	To       int    // number of receivers
	CanLeave bool   // the person joined from this page, so can leave from it
	Paused   string // why the service cannot work right now, if so
	Copy     bool   // the signed-in sender chose to keep their originals (otherwise they are moved to their trash)
	Album    string // receiver: the album arrivals are put in, if the service has one
	CanWatch bool   // sender: joined from this page, so may link an album
	Watch    string // sender: the album linked to this service, whose photos are all handed over

	Hold       string // why this sender's photos are on hold (paused by the owner, or by themselves); empty: not
	MinePaused bool   // sender: they paused their own membership
	CanPause   bool   // sender: joined from this page, so may pause
	Limit      string // the daily limit for each sender ("20 photos and 500 MB a day"); empty: none
	Used       string // sender: how much of it they have used in the last day
	Waiting    string // sender: photos waiting because the limit was reached, and until when
	Rules      string // sender: the service's quiet hours and what it accepts, in words; empty: no rules
	QuietWait  string // sender: photos waiting for the quiet hours, and until when
	Lifetime   string // sender: that the copies expire at the receiver, in words; empty: they stay
	TakeBack   string // sender: what the last hand-over holds, when it can be taken back ("3 photos handed over ..."); empty: nothing to take back
	Stopped    bool   // receiver: the owner paused this service
	Owned      bool   // receiver: the person offers this service themselves (it is shown with the services they offer)
	Account    string // sender: the name this person's account goes by in the service (what live events call them)
}

// OfferView is a service the signed-in person is not part of yet, and what they can do about it.
type OfferView struct {
	Name   string
	Tag    string
	Owner  string // empty for services from the configuration
	State  string // join | request | pending | approved | declined
	Invite string // the invitation token the person arrived with, if any
	Pool   bool   // an event pool: everyone sends and receives
	Ends   string // a pool's end, already written for the reader ("" for none)
}

// RequestView is someone waiting for the owner's decision.
type RequestView struct {
	ID, Name, Email string
}

// OwnedView is a service the signed-in person created.
type OwnedView struct {
	Name, Tag, Policy string
	Invite            string // invitation token; empty when the service is listed for everyone
	Broken            string // why the receiver key stopped working, if it did
	Album             string // the album arrivals are put in, if the service has one
	Requests          []RequestView
	Members           []MemberView
	Paused            bool // the owner paused it
	LimitPhotos       int  // daily cap per sender, 0: none
	LimitMB           int
	QuietFrom         string // quiet hours as HH:MM, empty: none
	QuietTo           string
	QuietLargeMB      int
	AcceptRating      int
	AcceptPhotos      bool
	AcceptOrient      string
	AcceptMaxMB       int
	LifetimeDays      int  // copies that arrive are moved to the owner's trash after this many days, 0: they stay
	DeleteOK          bool // the administrator allows it (RECEIVER_DELETE)
	BridgeOn          bool   // the administrator allows receivers on other servers (BRIDGE_ENABLE)
	BridgeInvite      string // the open link for someone on another server, if there is one
	HasBridge         bool   // the service has a receiver on another server
	BridgeName        string
	BridgeState       string // ok | unreachable | revoked
	BridgeNote        string // why it is not ok
	BridgeTakeBack    bool   // the receiver's key lets a sender take a hand-over back from there
	BridgeVersion     string // the other server's Immich version at the last check
	BridgeChecked     string // when it was last checked
	BridgeRetry       string // when an unreachable server is tried again
	BridgeStopped     string // why the service does not run for a reason that is not its receiver key (bridges switched off)
	Digest            DigestView
	Pool              bool   // an event pool
	PoolEnds          string // when it ends, "" for when the owner ends it
	PoolEnded         bool
}

// DigestView is a service's weekly digest as its owner sees it.
type DigestView struct {
	On, Running           bool
	Made, Ends, Next      string // already written for the reader
	Album, URL, Key       string // the album's name; the shared link's address when the app knows Immich's, else its key
	Photos, People, Left  int
	LeftList              []DigestLeftView
	Note                  string
}

// DigestLeftView is a photo a digest left out and why, in words.
type DigestLeftView struct{ Name, Why string }

// MemberView is a sender of a service the person owns.
type MemberView struct {
	Name  string
	State string // active | broken
	Copy  bool   // their originals are kept (otherwise moved to their trash)
	Paused  bool   // they paused their membership
	AtLimit bool   // they reached the service's daily limit
	Used    string // what they handed over in the last day, when the service has a limit
}

// BrokenView is a connection of the person that Immich rejected.
type BrokenView struct {
	Service, Note string
}

// ActivityView is one line of the activity log.
type ActivityView struct {
	When, Text string
	Tone       string // ok | warn | bad | "" : the colour of the dot on the timeline
}

// Chip is a small state label on a service row.
type Chip struct{ Tone, Text string }

// SceneLane is one sender's lane in the live scene.
type SceneLane struct {
	Name     string // what live events call the sender
	State    string // flow | paused | capped | broken
	PausedBy string // service | sender, when State is paused
}

// SceneStage is one service in the live scene: its senders' lanes and the gate they hand photos through.
type SceneStage struct {
	Service string
	Where   string // one line about the receiving side
	Out     bool   // the person sends here: the photos fly away from them, not toward them
	Lanes   []SceneLane
}

// NeedAction is a button on a card in the "Needs you" strip.
type NeedAction struct {
	Label, Path, Vals string
	Confirm           string // asked before it runs; empty: no question
	Primary           bool
	Key               string // a key that presses it from the keyboard (shown on the button); empty: none
}

// NeedView is one thing that waits on the person: a request to approve, a connection to restore, a pause or a
// limit that holds photos back. Tone is the chip colour (bad, warn or empty).
type NeedView struct {
	Tone, Chip, Title, Text string
	Actions                 []NeedAction
}

// DayBar is one day of the week's chart.
type DayBar struct {
	Label string // "Mon"
	N     int
}

// NumbersView is the three numbers at the top of the Overview. Waiting only means something to a sender and Inbox to
// a receiver, so each is shown only to the people it is about.
type NumbersView struct {
	Loading          bool // the first paint: skeletons, until the page asks for the real numbers
	Sender, Receiver bool
	Waiting, Inbox   int
	Week             int
	Days             [7]DayBar
}

// GuideStep is one step of the first-run guide.
type GuideStep struct {
	Text string
	Done bool
}

// GuideView is the first-run guide, shown until it is finished or hidden.
type GuideView struct {
	Steps    []GuideStep
	Done     int
	NextStep string // what to do next, as the heading
}

// DashboardData is everything the main page shows.
type DashboardData struct {
	User     string
	Services []ServiceView
	Offers   []OfferView
	Owned    []OwnedView
	Invited  *OfferView // the service an invitation link leads to
	Orphaned []string   // services the person joined that their owner has since removed
	Broken   []BrokenView
	Activity []ActivityView
	TagsOff  bool // Tags are switched off in the person's Immich account, so they cannot add or see tags
	CanOffer bool // people may create services on this install
	DeleteOK bool // new receiver keys may move copies to their owner's trash (RECEIVER_DELETE), which the dialog that makes a key says
	Last     *syncer.RunInfo

	Headline   string // the greeting, e.g. "Hello, Alice."
	Gist       string // the highlighted half of the heading, e.g. "Two things need you."
	Needs      []NeedView
	Scene      []SceneStage // one stage per service that has senders
	ShowNumber bool       // there is something to count: the person takes part in a service
	Guide      *GuideView // nil: finished, hidden, or nowhere to remember it
	Mail       MailView
	Push       PushView
	DropBoxes  []DropBoxView
	Frames     []FrameView
	Templates  []TemplateView
}

// DropBoxView is one of the person's drop boxes: a link through which people without an Immich account send photos.
type DropBoxView struct {
	ID, Name, Message string
	Token             string // the link is made from it in the browser
	State             string // open, paused, expired or revoked
	Note              string // why it is paused, when it paused itself
	Files             int
	Size              string // what it holds, e.g. "12.4 MB"
	Limits            string // the limits in words
	Ends              string // when the link stops working, when it will
	Locked            bool   // guests need a password
	LockedPage        bool   // and it guards the whole page, not only sending
	Log               []ActivityView

	Role                string // owner, manage or view
	Owner, Manage       bool   // the owner may do everything; a co-host who manages may do all but end the box and choose co-hosts
	Album, ExtraTag     string // where files are filed besides the inbox tag
	Approve             bool   // files wait for approval
	Opens               string // when it opens, if it has not yet
	Summary             string // what it took, in a sentence
	CanExtend           bool
	PendingN            int // files waiting for a decision
	Pending             []PendingView
	Hosts               []HostView

	Prompts        []PromptView
	PromptsText    string // the shot list, one per line, as the form edits it
	PromptRequired bool
	GuestBook      bool
	Messages       []MessageView
	Share          *ShareView // the shared link guests can see the photos at, when the box has one
	WallToken      string
	Highlight      *HighlightView
	OnwardService  string
	OnwardAuto     bool
	OnwardOptions  []OnwardOptionView
	OnwardLog      []OnwardView
	HasBest        bool

	Short       string // the short code, if the box has a short link
	MailOn      bool   // a mailbox is set up, so the box can have an address
	MailAddress string // the box's mail address, if it has one
	MailLocked  bool   // the box has a password, which a mail cannot give
	Accent      string
	Lang        string
	MaxDim      int
	HasCover    bool
	GuestDelete bool
	Title       string // the name guests see, if the host gave one
	HasLogo     bool
	KeepDays    int    // days after the box ends that what guests left with it is kept (0: until it is revoked)
	KeepUntil   string // when that goes, once the box has an end

	Gallery, GalleryDownload, GalleryNames bool // guests may look at the photos and heart them; download them; see who sent them
	ModToken                               string // the moderator link's token (the owner sees it), "" for none
}

// ModPageView is the moderator's page: what waits in the box, and how the last decision went.
type ModPageView struct {
	Token, Name, Message string
	Total                int
	Items                []PendingView
	Looks                bool           // the key may look at pictures, so the photos the box kept can be shown
	Photos               []ModPhotoView // the photos the box kept, newest first
	More                 string         // the position to ask for the next page from ("" when there is none)
}

// ModPhotoView is a photo the box kept, with what the host picked for it.
type ModPhotoView struct {
	ID, By         string
	Hearts         int
	Hidden, Pinned bool
}

// HighlightView is a box's best-of as the owner reads it.
type HighlightView struct {
	Status, Strictness, Album, Note, When string
	Total, Done, Kept, OutCount           int
	Excluded                              []VerdictView
}

// VerdictView is a photo a best-of left out, and why.
type VerdictView struct {
	Name, Reason, Detail string
}

// OnwardOptionView is a service a box's photos can be handed on to.
type OnwardOptionView struct {
	Service string
	Copy    bool
}

// OnwardView is one time a box's photos were handed on.
type OnwardView struct {
	When, Service, Scope, By string
	Count                    int
}

// PromptView is one prompt of a shot list and how many photos came for it.
type PromptView struct {
	ID, Text string
	Files    int
}

// MessageView is a message in a box's guest book, as the owner reads it.
type MessageView struct {
	ID, Name, Text, When string
	HasAudio             bool
	OnWall               bool
}

// ShareView is the shared link of a box. URL is empty when the app does not know where Immich is; the page then makes
// the address in the browser from the key.
type ShareView struct {
	Key, URL, Expires, Message string
}

// TemplateView is a template a drop box can be started from.
type TemplateView struct {
	ID, Name, Summary string
	Builtin           bool
}

// GuestFileView is a file a guest sent, as the guest sees it on their own page.
type GuestFileView struct {
	ID, Name, Size string
	Waiting        bool
}

// PendingView is a file a guest sent that waits for a host's decision.
type PendingView struct {
	ID, Name, Size string
	Image          bool // it can be shown as a picture
}

// HostView is a co-host of a drop box.
type HostView struct {
	ID, Name, Email string
	Manage          bool
}

// DropPageView is what a guest sees at a drop box's link.
type DropPageView struct {
	Token, Name, Message string
	Password             bool
	PhotosOnly           bool
	Approve              bool // a host looks at files before they are kept
	Limits               string
	MaxDim               int  // photos larger than this are shrunk in the browser (0: not)
	Cover                bool // the box has a cover photo
	CanDelete            bool // guests may take back what they sent
	Prompts              []PromptView
	PromptRequired       bool
	GuestBook            bool
	Logo                 bool // the box has a logo
	Gallery              bool // guests may look at the photos the box kept, and heart them
	GalleryDownload      bool // and download them
	GalleryNames         bool // and the page asks for a name to show with the photos
}

// DropResultLine is what became of one file a guest sent.
type DropResultLine struct {
	Name, Text string
	OK         bool
}

templ Layout(title, user string) {
	<!DOCTYPE html>
	<html lang={ loc(ctx).Code() } { htmlTheme(ctx)... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"includeIndicatorStyles": false}'/>
			if b := baseHref(ctx); b != "" {
				<base href={ b }/>
			}
			<title>{ title }</title>
			<link rel="icon" href="static/favicon.svg" type="image/svg+xml"/>
			if g := guestOf(ctx); g != nil && g.Token != "" {
				<link rel="manifest" href={ "drop/" + g.Token + "/manifest.webmanifest" }/>
				if g.Accent {
					<link rel="stylesheet" href={ "drop/" + g.Token + "/theme.css" }/>
				}
			} else {
				<link rel="manifest" href="static/manifest.webmanifest" crossorigin="use-credentials"/>
			}
			<link rel="apple-touch-icon" href="static/apple-touch-icon.png"/>
			<meta name="theme-color" content={ themeColor(paletteOf(ctx), false) } media="(prefers-color-scheme: light)"/>
			<meta name="theme-color" content={ themeColor(paletteOf(ctx), true) } media="(prefers-color-scheme: dark)"/>
			<meta name="apple-mobile-web-app-title" content="Handoff"/>
			<link rel="stylesheet" href="static/app.css"/>
			@templ.JSONScript("i18n", clientCatalog(ctx))
			<script src="static/theme.js"></script>
			<script src="static/htmx.min.js" defer></script>
			<script src="static/app.js" defer></script>
		</head>
		<body hx-headers='{"X-Requested-With": "immich-handoff"}'>
			<div id="glow" aria-hidden="true"></div>
			<div class="wrap">
				<header class="bar">
					<div class="brand">
						<img src="static/favicon.svg" alt="" width="28" height="28"/>
						<span class="t">{ t(ctx, "Immich Handoff") }</span>
					</div>
					<details class="lang">
						<summary class="icon-btn wide" aria-label={ t(ctx, "Language") } title={ t(ctx, "Language") }>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"></path></svg>
							<span class="lang-code">{ loc(ctx).Code() }</span>
						</summary>
						<ul class="lang-menu" role="menu">
							for _, l := range languages() {
								<li role="none"><button type="button" role="menuitemradio" data-lang={ string(l) } aria-checked={ checked(loc(ctx).Lang == l) } lang={ string(l) }>{ langName(l) }</button></li>
							}
						</ul>
					</details>
					if user != "" {
						<div class="who">
							if isAdmin(ctx) {
								<a class="adminlink" href="admin">{ t(ctx, "Admin") }</a>
							}
							if hasTabs(ctx) {
								<button type="button" class="icon-btn wide" id="palette" aria-label={ t(ctx, "Open the command palette") } title={ t(ctx, "Jump anywhere or do something from the keyboard (Ctrl K)") }><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg><span class="lbl">{ t(ctx, "Search") }</span> <span class="kbd">{ t(ctx, "Ctrl K") }</span></button>
							}
							<span id="live" class="live off" title={ t(ctx, "Live updates") } role="img" aria-label={ t(ctx, "Live updates") }></span>
							<details class="scheme">
								<summary class="icon-btn" aria-label={ t(ctx, "Colour scheme") } title={ t(ctx, "Choose the colour scheme") }>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18c1.1 0 1.6-.8 1.6-1.6 0-.9-.6-1.4-.6-2.2 0-.9.7-1.5 1.7-1.5H16a5 5 0 0 0 5-5c0-4.2-4-7.7-9-7.7z"></path><circle cx="7.5" cy="11" r="1" fill="currentColor"></circle><circle cx="10.5" cy="7" r="1" fill="currentColor"></circle><circle cx="15" cy="7.5" r="1" fill="currentColor"></circle></svg>
								</summary>
								<ul class="scheme-menu" role="menu">
									for _, p := range Themes() {
										<li role="none"><button type="button" role="menuitemradio" data-palette={ p } aria-checked={ checked(paletteOf(ctx) == p) }><span class={ "swatch", p } aria-hidden="true"></span>{ themeLabel(ctx, p) }</button></li>
									}
								</ul>
							</details>
							<button type="button" class="icon-btn" id="theme" aria-label={ t(ctx, "Dark theme") } title={ t(ctx, "Switch between the light and the dark theme") } aria-pressed="false">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 3.5v17" ></path><path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor" stroke="none"></path></svg>
							</button>
							if hasTabs(ctx) {
								<button type="button" class="icon-btn" id="sound" aria-label={ t(ctx, "Arrival chime and vibration") } title={ t(ctx, "Arrival chime and vibration when a photo lands") } aria-pressed="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z"></path><g class="on"><path d="M16.5 8.5a5 5 0 0 1 0 7"></path><path d="M19 6a8.5 8.5 0 0 1 0 12"></path></g><path class="off" d="M17 9l5 6M22 9l-5 6"></path></svg>
								</button>
							}
							<span class="avatar" aria-hidden="true">{ initial(user) }</span>
							<span>{ user }</span>
						</div>
					}
				</header>
				if hasTabs(ctx) {
					<nav class="tabs" aria-label={ t(ctx, "Views") }>
						<i class="blob" aria-hidden="true"></i>
						<a href="#overview" data-view="overview"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="2"></rect><rect x="13" y="3" width="8" height="5" rx="2"></rect><rect x="13" y="10" width="8" height="11" rx="2"></rect><rect x="3" y="13" width="8" height="8" rx="2"></rect></svg><span>{ t(ctx, "Overview") }</span></a>
						<a href="#services" data-view="services"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12h8M13 8l4 4-4 4"></path></svg><span>{ t(ctx, "Services") }</span></a>
						<a href="#activity" data-view="activity"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"></path></svg><span>{ t(ctx, "Activity") }</span></a>
						<a href="send" class="send-tab"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4"></path><path d="m7 9 5-5 5 5"></path><path d="M5 15v3a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-3"></path></svg><span>{ t(ctx, "Send") }</span></a>
					</nav>
				}
				<main>
					{ children... }
				</main>
				if !isGuest(ctx) {
					<footer>
						{ t(ctx, "Photos you tag in Immich are handed over automatically.") }
						if v := versionOf(ctx); v != "" && user != "" {
							<span class="version" title={ t(ctx, "The version of Immich Handoff that is running") }>· Immich Handoff { v }</span>
						}
					</footer>
				}
				if hasTabs(ctx) {
					<dialog id="cmd" class="cmd" aria-label={ t(ctx, "Command palette") }>
						<input id="cmd-q" type="text" placeholder={ t(ctx, "Type a command or the name of a service") } aria-label={ t(ctx, "Command") } autocomplete="off" role="combobox" aria-controls="cmd-list" aria-expanded="true"/>
						<ul id="cmd-list" role="listbox"></ul>
					</dialog>
				}
				<dialog id="confirm" class="confirm" aria-labelledby="confirm-title">
					<form method="dialog">
						<h3 id="confirm-title">{ t(ctx, "Please confirm") }</h3>
						<p id="confirm-text" class="meta"></p>
						<p class="row confirm-actions">
							<button value="cancel">{ t(ctx, "Cancel") }</button>
							<button value="ok" id="confirm-ok" class="primary">{ t(ctx, "Continue") }</button>
						</p>
					</form>
				</dialog>
			</div>
		</body>
	</html>
}

// TagsNotice offers to switch Tags on, which Immich has off by default and which everyone taking part needs.
templ TagsNotice() {
	<div class="card notice tags" id="tags-notice">
		<header><span class="chip warn">{ t(ctx, "Tags are off") }</span></header>
		<h3>{ t(ctx, "Tags are switched off in your Immich account") }</h3>
		<p class="meta">{ t(ctx, "Tags are how photos are handed over, and how you find what arrived. While they are off you cannot add tags in Immich or see them, so the rest of this page is switched off until you turn them on. Turning them on changes one setting in your Immich account, the same as Account Settings, Features, Tags.") }</p>
		<p class="row"><button class="primary" hx-post="preferences/tags" hx-target="#tags-notice" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Turn on Tags") }</button></p>
	</div>
}

templ Dashboard(d DashboardData) {
	@Layout("Immich Handoff", d.User) {
		<p id="flash" class="toast" role="status" aria-live="polite"></p>
		if d.TagsOff {
			@TagsNotice()
		}
		<div id="gated" { gate(d.TagsOff)... }>
		<section class="view" id="v-overview" aria-label={ t(ctx, "Overview") }>
			<p class="eyebrow" data-today aria-hidden="true"></p>
			<h1>{ d.Headline } <em>{ d.Gist }</em></h1>
			<p class="lead">{ t(ctx, "Everything that was handed over went through; these are the only things that wait on a person. Tag a photo in the Immich app and it is handed over within seconds.") }</p>
			if len(d.Scene) > 0 {
				<h2>{ t(ctx, "Live") } <span class="chip ok">{ t(ctx, "as it happens") }</span></h2>
				@Scene(d.Scene)
			}
			<button type="button" class="cmdbar" id="cmdbar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg><span class="grow">{ t(ctx, "Type a command or the name of a service") }</span><span class="kbd">{ t(ctx, "Ctrl K") }</span></button>
			<h2>{ t(ctx, "Needs you") } <span class="count-badge">{ fmt.Sprint(len(d.Needs)) }</span></h2>
			if len(d.Needs) == 0 {
				<div class="card need allclear"><b><span class="chip ok">{ t(ctx, "All clear") }</span> { t(ctx, "Nothing needs you") }</b><p class="meta">{ t(ctx, "Nothing needs you right now. New requests and problems appear here first.") }</p></div>
			}
			<div class="needs">
				for _, n := range d.Needs {
					@NeedCard(n)
				}
			</div>
			if d.ShowNumber {
				<h2>{ t(ctx, "This week") }</h2>
				@Numbers(NumbersView{Loading: true})
			}
			if d.Guide != nil {
				@Guide(*d.Guide)
			}
			if d.Mail.Available {
				@MailCard(d.Mail)
			}
			if d.Push.Available {
				@PushCard(d.Push)
			}
		</section>
		<section class="view" id="v-services" aria-label={ t(ctx, "Services") }>
			<h1>
				@templ.Raw(h(ctx, "Your <em>services</em>"))
			</h1>
			<p class="lead">{ t(ctx, "Open a service to see how it works, change who can send, pause it or set a daily limit. What cannot be undone sits at the bottom of each one.") }</p>
			if d.RowCount() == 0 {
				<div class="card empty">{ t(ctx, "You do not take part in any service yet.") }</div>
			}
			if len(d.Sending()) > 0 {
				<h2>{ t(ctx, "You send to") }</h2>
				for i, sv := range d.Sending() {
					@SendRow(sv, fmt.Sprintf("send-%d", i), d.RowCount() == 1)
				}
			}
			if len(d.Receiving()) > 0 {
				<h2>{ t(ctx, "You receive") }</h2>
				for i, sv := range d.Receiving() {
					@ReceiveRow(sv, fmt.Sprintf("recv-%d", i), d.RowCount() == 1)
				}
			}
			if len(d.Owned) > 0 {
				<h2>{ t(ctx, "You offer") }</h2>
				for i, o := range d.Owned {
					@OwnedRow(o, fmt.Sprintf("own-%d", i), d.RowCount() == 1)
				}
			}
			if len(d.Offers) > 0 {
				<h2>{ t(ctx, "You can join") }</h2>
				for _, o := range d.Offers {
					@OfferCard(o)
				}
			}
			if d.CanOffer {
				<details class="offer">
					<summary>{ t(ctx, "Offer a service of your own") }</summary>
					@OfferForm(d.DeleteOK)
				</details>
				@DropBoxSection(d.DropBoxes, d.Templates)
				@FrameSection(d.Frames)
			}
		</section>
		<section class="view" id="v-activity" aria-label={ t(ctx, "Activity") }>
			<h1>
				@templ.Raw(h(ctx, "What <em>happened</em>"))
			</h1>
			<p class="lead">{ t(ctx, "The latest events across your services. Nothing here changes a photo.") }</p>
			if len(d.Activity) > 0 {
				<section class="card timeline-card" aria-label={ t(ctx, "Recent events") }>
					<ol class="timeline">
						for _, a := range d.Activity {
							<li><time>{ a.When }</time><span class={ "dot", a.Tone } aria-hidden="true"></span><span>{ a.Text }</span></li>
						}
					</ol>
				</section>
			} else {
				<div class="card empty">{ t(ctx, "Nothing has happened yet.") }</div>
			}
			if len(d.Services) > 0 {
				<h2>{ t(ctx, "Last run") }</h2>
				@LastRun(d.Last)
				<p class="row">
					<button class="primary" hx-post="sync" hx-target="#synctoast" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Sync now") }</button>
					<span id="synctoast" class="toast" aria-live="polite"></span>
				</p>
			}
		</section>
		</div>
	}
}

// MailCard lets a person ask for email about what happens to their services.
templ MailCard(m MailView) {
	<h2>{ t(ctx, "Email me") }</h2>
	<div class="card mailcard">
		if m.On {
			<p>{ t(ctx, "You get an email about what happens to your services, at {email}.", "email", m.Email) }</p>
		} else {
			<p>{ t(ctx, "Get an email when something happens to your services, instead of having to open this page.") }</p>
		}
		<form class="limits" hx-post="me/mail" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
			<input type="hidden" name="action" value="on"/>
			<label><input type="radio" name="mode" value="all" checked?={ m.Mode != "needs" }/> { t(ctx, "Everything that happens to my services") }</label>
			<label><input type="radio" name="mode" value="needs" checked?={ m.Mode == "needs" }/> { t(ctx, "Only what needs me") }</label>
			if m.On {
				<button type="submit">{ t(ctx, "Save") }</button>
			} else {
				<button class="primary" type="submit">{ t(ctx, "Turn on email") }</button>
			}
		</form>
		if m.On {
			<p class="row">
				<button hx-post="me/mail" hx-vals='{"action":"test"}' hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Send a test email") }</button>
				<button hx-post="me/mail" hx-vals='{"action":"off"}' hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Turn off") }</button>
			</p>
		}
		<small class="meta">{ t(ctx, "Emails go to the address Immich shows for your account, in the language of this page, and arrive a few minutes after things happen, in one email. Every email has a link that stops them.") }</small>
	</div>
}

// PushCard lets a person allow notifications on the phone or computer they are using, and shows the devices they allowed.
// The script (ts/push.ts) shows the controls only where the browser can do it, and says why when it cannot.
templ PushCard(p PushView) {
	<h2>{ t(ctx, "Notifications on this device") }</h2>
	<div class="card pushcard" id="pushcard" data-key={ p.Key }>
		<p>{ t(ctx, "Get a notification on this phone or computer when something happens to your services, even when this page is closed.") }</p>
		<p class="meta" data-push-note hidden></p>
		<div data-push-controls hidden>
			<p class="row">
				<label><input type="radio" name="pushmode" value="all" checked/> { t(ctx, "Everything that happens to my services") }</label>
				<label><input type="radio" name="pushmode" value="needs"/> { t(ctx, "Only what needs me") }</label>
			</p>
			<p class="row"><button class="primary" type="button" data-push-on>{ t(ctx, "Turn on notifications here") }</button></p>
		</div>
		if len(p.Devices) > 0 {
			<h3>{ t(ctx, "Your devices") }</h3>
			<ul class="plain devices">
				for _, dv := range p.Devices {
					<li data-device={ dv.ID }>
						<b>{ dv.Label }</b> <span class="chip ok" data-here-mark hidden>{ t(ctx, "This device") }</span>
						<small class="meta">{ t(ctx, "Added {when}", "when", dv.Added) }
							if dv.LastOK != "" {
								· { t(ctx, "Last delivered {when}", "when", dv.LastOK) }
							}
						</small>
						<span class="row">
							<select data-push-mode aria-label={ t(ctx, "What this device is told") }>
								<option value="all" selected?={ dv.Mode != "needs" }>{ t(ctx, "Everything that happens to my services") }</option>
								<option value="needs" selected?={ dv.Mode == "needs" }>{ t(ctx, "Only what needs me") }</option>
							</select>
							<button type="button" data-push-test>{ t(ctx, "Send a test notification") }</button>
							<button type="button" data-push-remove>{ t(ctx, "Remove") }</button>
						</span>
					</li>
				}
			</ul>
		}
		<small class="meta">{ t(ctx, "The notification reaches your device through the push service of your browser (Google, Mozilla, Apple or Microsoft), which can see that a message was sent and when, not what it says. Remove a device here to stop it.") }</small>
	</div>
}

// ActionPageView is the page a one-tap link leads to: the question and the button, or how it ended.
type ActionPageView struct {
	Token, Question, Button string
	Done                    bool
	Failed                  string
}

// ActionPage asks before it acts, and says how it ended.
templ ActionPage(v ActionPageView) {
	@Layout("Immich Handoff", "") {
		<section class="invite-hero">
			switch {
				case v.Done:
					<h1>{ t(ctx, "Done.") }</h1>
					<p class="lead"><a href="./">{ t(ctx, "Open Immich Handoff") }</a></p>
				case v.Failed != "":
					<h1>{ t(ctx, "Not done") }</h1>
					<p class="lead">{ v.Failed }</p>
					<p class="lead"><a href="./">{ t(ctx, "Open Immich Handoff") }</a></p>
				default:
					<h1>{ v.Question }</h1>
					<form method="post" action={ "a/" + v.Token }>
						<p class="row form-actions"><button class="primary" type="submit">{ v.Button }</button></p>
					</form>
			}
		</section>
	}
}

// UnsubscribePage is where the link in a mail leads: it asks first, so a program that opens the link does not stop anyone's mail.
templ UnsubscribePage(token string, done bool) {
	@Layout(t(ctx, "Stop the emails"), "") {
		<section class="invite-hero">
			if done {
				<h1>{ t(ctx, "No more emails") }</h1>
				<p class="lead">{ t(ctx, "You will not get any more emails from Immich Handoff. You can turn them on again from your page.") }</p>
			} else {
				<h1>{ t(ctx, "Stop the emails?") }</h1>
				<p class="lead">{ t(ctx, "Immich Handoff will stop writing to you about what happens to your services.") }</p>
				<form method="post" action={ "unsubscribe/" + token }>
					<p class="row form-actions"><button class="primary" type="submit">{ t(ctx, "Stop these emails") }</button></p>
				</form>
			}
		</section>
	}
}

// PoolCard is what an owner sees of an event pool: what it is, when it ends, and how to end or extend it.
templ PoolCard(o OwnedView) {
	<div class="field pool">
		<label>{ t(ctx, "Event pool") }</label>
		<p class="meta">{ t(ctx, "Everyone in it, you too, sends and receives: a photo anyone tags goes to everyone else in the pool, tagged with who took it, and nobody's originals are touched. A person who joins later gets what is shared from then on; one who leaves keeps what they received.") }</p>
		<p class="meta">
			if o.PoolEnded {
				<span class="chip bad">{ t(ctx, "Ended") }</span> { t(ctx, "The pool ended {when}. Nothing more is handed over; what was handed over stays.", "when", o.PoolEnds) }
			} else if o.PoolEnds != "" {
				<span class="chip ok">{ t(ctx, "Open") }</span> { t(ctx, "It ends {when}.", "when", o.PoolEnds) }
			} else {
				<span class="chip ok">{ t(ctx, "Open") }</span> { t(ctx, "It goes on until you end it.") }
			}
		</p>
		<form class="limits" hx-post="services/pool" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
			<input type="hidden" name="service" value={ o.Name }/>
			<label>{ t(ctx, "Let it end after (days from now, empty: never)") } <input name="days" type="number" min="1" max="366" class="narrow"/></label>
			<button type="submit" name="do" value="set">{ t(ctx, "Save the end") }</button>
			if !o.PoolEnded {
				<button type="submit" name="do" value="end" class="danger">{ t(ctx, "End the pool now") }</button>
			}
		</form>
	</div>
}

// DigestCard is the weekly digest of a service: on or off, the last one and why photos were left out of it.
templ DigestCard(service string, d DigestView, id string) {
	<div class="field digest">
		<label>{ t(ctx, "Weekly digest") }</label>
		<p class="meta">{ t(ctx, "Every Monday morning the best photos that arrived in the last week are put in an album of yours and a link to it is made that ends after a month. The photos that are too dark, too bright, blurred or the same moment as a better one are left out, and you can see which and why. Nothing is deleted or changed.") }</p>
		if d.On {
			<p class="meta"><span class="chip ok">{ t(ctx, "On") }</span>
				if d.Next != "" {
					{ t(ctx, "Next digest: {when}", "when", d.Next) }
				}
				if d.Running {
					<span class="chip">{ t(ctx, "Being made now") }</span>
				}
			</p>
			if d.Made != "" {
				<p class="meta">{ t(ctx, "Last one made {when}.", "when", d.Made) }
					if d.Note != "" {
						{ unpack(ctx, d.Note) }
					}
				</p>
			}
			if d.Photos > 0 {
				<p class="meta">{ n(ctx, "{n} photo of the week from {people} in the album {album}", "{n} photos of the week from {people} in the album {album}", d.Photos, "people", n(ctx, "{n} person", "{n} people", d.People), "album", d.Album) }
					if d.Left > 0 {
						· { n(ctx, "{n} left out", "{n} left out", d.Left) }
					}
				</p>
			}
			if d.Key != "" {
				<div class="row">
					if d.URL != "" {
						<input id={ "dg-" + id } class="invite" readonly value={ d.URL }/>
						<button type="button" class="copy">{ t(ctx, "Copy") }</button>
					} else {
						<span class="meta">{ t(ctx, "Link: your Immich address followed by /share/{key}", "key", d.Key) }</span>
					}
					<span class="meta">{ t(ctx, "ends {when}", "when", d.Ends) }</span>
				</div>
			}
			if len(d.LeftList) > 0 {
				<details>
					<summary>{ t(ctx, "What was left out, and why") }</summary>
					<ul class="plain">
						for _, l := range d.LeftList {
							<li>{ l.Name } <span class="meta">{ l.Why }</span></li>
						}
					</ul>
				</details>
			}
			<p class="row">
				<button hx-post="services/digest" hx-vals={ vals2("service", service, "do", "now") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Make this week's digest now") }</button>
				<button hx-post="services/digest" hx-vals={ vals2("service", service, "do", "off") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Turn off") }</button>
			</p>
		} else {
			<p class="row"><button hx-post="services/digest" hx-vals={ vals2("service", service, "do", "on") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Turn on the weekly digest") }</button></p>
			<small class="meta">{ t(ctx, "Turning it on lets this service's key look at pictures and make an album and a shared link in your Immich account. Turning it off takes that away again.") }</small>
		}
	</div>
}

// WatchBox is where a sender links one of their albums to a service, so everything in it is handed over.
templ WatchBox(s ServiceView) {
	<div class="watch">
		if s.Watch != "" {
			<p class="meta">
				@templ.Raw(h(ctx, "Everything in your album <strong>{album}</strong> is handed over to this service, now and whatever you add to it later. The app looks at it every few minutes, and each photo is handed over once.", "album", s.Watch))
			</p>
		}
		<p class="row">
			if s.Watch != "" {
				<button hx-post="services/album/stop" hx-vals={ vals("service", s.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Stop handing over this album") }</button>
			}
			<button hx-get={ "fragments/albums?service=" + url.QueryEscape(s.Name) } hx-target="next .albumform" hx-swap="innerHTML" hx-disabled-elt="this">
				if s.Watch != "" {
					{ t(ctx, "Link a different album") }
				} else {
					{ t(ctx, "Hand over a whole album") }
				}
			</button>
		</p>
		<div class="albumform"></div>
	</div>
}

// AlbumChoice is the form that follows: the sender's own albums, and a button to link the chosen one.
templ AlbumChoice(service string, albums []AlbumOption, copies bool) {
	if len(albums) == 0 {
		<p class="meta">{ t(ctx, "You have no albums of your own yet. Make one in Immich, then come back.") }</p>
	} else {
		<form class="card" hx-post="services/album" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button" hx-confirm={ albumConfirm(ctx, service, copies) } data-confirm-title={ t(ctx, "Hand over this album?") } data-confirm-label={ t(ctx, "Hand over") }>
			<input type="hidden" name="service" value={ service }/>
			<div class="field">
				<label for="watch-album">{ t(ctx, "Album to hand over to {service}", "service", service) }</label>
				<select id="watch-album" name="album">
					for _, a := range albums {
						<option value={ a.ID }>{ a.Label }</option>
					}
				</select>
			</div>
			<p class="meta">{ t(ctx, "Everything in it, and whatever you add later, goes to {service}.", "service", service) } { originalsNote(ctx, copies) } { t(ctx, "Only photos you own are used.") }</p>
			<p class="row"><button class="primary" type="submit">{ t(ctx, "Hand over this album") }</button></p>
		</form>
	}
}

// RowHead is the always-visible line of a service row: a coloured initial, the name and what it is, state chips,
// and the number that matters (filled in by the page asking for it, see Count).
templ RowHead(name, subtitle string, chips []Chip, sum string) {
	<summary>
		<span class={ "badge", hueClass(name) } aria-hidden="true">{ initial(name) }</span>
		<span class="title"><b>{ name }</b><span>{ subtitle }</span></span>
		<span class="chips">
			for _, c := range chips {
				<span class={ "chip", c.Tone }>{ c.Text }</span>
			}
		</span>
		<span id={ sum } class="sum"><span class="skeleton"></span></span>
		<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
	</summary>
}

// SendRow is a service the person sends to: what is on hold, how to send, the album, and (apart) how to leave.
templ SendRow(s ServiceView, id string, open bool) {
	<details class="svc card" name="svc" open?={ open }>
		@RowHead(s.Name, roleLabel(ctx, s.Role)+" \u00b7 "+originalsShort(ctx, s.Copy), sendChips(ctx, s), "sum-"+id)
		<div class="body">
			if s.Paused != "" {
				<p class="meta"><span class="chip warn">{ t(ctx, "Paused") }</span> { s.Paused } { t(ctx, "Photos stay where they are until it is fixed.") }</p>
			}
			if s.Hold != "" {
				<p class="meta"><span class="chip warn">{ t(ctx, "Paused") }</span> { s.Hold } { t(ctx, "Photos tagged meanwhile stay tagged and are handed over when it resumes.") }</p>
			}
			if s.Limit != "" {
				<p class="meta">{ t(ctx, "The owner limits each sender to {limit}.", "limit", s.Limit) } { s.Used }</p>
			}
			if s.Waiting != "" {
				<p class="meta"><span class="chip warn">{ t(ctx, "Waiting") }</span> { s.Waiting }</p>
			}
			if s.QuietWait != "" {
				<p class="meta"><span class="chip warn">{ t(ctx, "Waiting") }</span> { s.QuietWait }</p>
			}
			if s.Rules != "" {
				<p class="meta">{ s.Rules }</p>
			}
			if s.Lifetime != "" {
				<p class="meta">{ s.Lifetime }</p>
			}
			if s.TakeBack != "" {
				<p class="row">
					<button data-act="takeback" hx-post="services/takeback" hx-vals={ vals("service", s.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The copies in the receiver's library go to their trash, except the ones they have already filed in an album, and your originals come back from your trash (if you moved them) without the service tag. Nothing is deleted for good.") } data-confirm-title={ t(ctx, "Take back the last hand-over?") } data-confirm-label={ t(ctx, "Take back") }>{ t(ctx, "Take back the last hand-over") }</button>
					<span class="meta">{ s.TakeBack }</span>
				</p>
			}
			<p class="meta">
				@templ.Raw(h(ctx, `Add the tag <code class="tag">{tag}</code> to a photo in Immich to send it.`, "tag", s.Tag))
				{ originalsNote(ctx, s.Copy) }
				{ " " + n(ctx, "{n} sender", "{n} senders", s.From) + ", " + n(ctx, "{n} receiver", "{n} receivers", s.To) + "." }
			</p>
			<div class="stats">
				<div class="stat" hx-get={ countURL(s.Name, s.Role, "sum-"+id) } hx-trigger="load, handoff:run from:body" hx-swap="innerHTML">
					<span class="skeleton"></span>
					<small>{ countLabel(ctx, s.Role) }</small>
				</div>
			</div>
			if s.CanWatch {
				@WatchBox(s)
			}
			if s.CanPause {
				<p class="row">
					if s.MinePaused {
						<button class="primary" data-act="resume" hx-post="pause" hx-vals={ pauseVals(s.Name, false) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Resume sending") }</button>
					} else {
						<button data-act="pause" hx-post="pause" hx-vals={ pauseVals(s.Name, true) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Pause sending to this service? Photos you tag stay tagged and are handed over when you resume.") } data-confirm-title={ t(ctx, "Pause sending?") } data-confirm-label={ t(ctx, "Pause") }>{ t(ctx, "Pause sending") }</button>
					}
				</p>
			}
			if s.CanLeave {
				<div class="danger-zone">
					<span class="meta">{ t(ctx, "Leaving deletes the API key and the workflow this app made in your Immich account. Your photos are not touched.") }</span>
					<button class="danger" hx-post="leave" hx-vals={ vals("service", s.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Leave {name}? Your Immich API key for it and its workflow will be deleted.", "name", s.Name) } data-confirm-title={ t(ctx, "Leave {name}?", "name", s.Name) } data-confirm-label={ t(ctx, "Leave") } data-danger="true">{ t(ctx, "Leave") }</button>
				</div>
			}
		</div>
	</details>
}

// ReceiveRow is a service from the configuration that the person receives from (the ones they offer are OwnedRow).
templ ReceiveRow(s ServiceView, id string, open bool) {
	<details class="svc card" name="svc" open?={ open }>
		@RowHead(s.Name, roleLabel(ctx, s.Role)+" \u00b7 "+receiveShort(ctx, s), recvChips(ctx, s), "sum-"+id)
		<div class="body">
			if s.Paused != "" {
				<p class="meta"><span class="chip warn">{ t(ctx, "Paused") }</span> { s.Paused } { t(ctx, "Photos stay where they are until it is fixed.") }</p>
			}
			if s.Stopped {
				<p class="meta"><span class="chip warn">{ t(ctx, "Paused") }</span> { t(ctx, "This service is paused: nothing is handed over to you until it resumes.") }</p>
			}
			<p class="meta">
				if s.Album != "" {
					@templ.Raw(h(ctx, "Photos arrive in the album <strong>{album}</strong>.", "album", s.Album))
				} else {
					@templ.Raw(h(ctx, `Photos arrive tagged <code class="tag">{tag}</code>.`, "tag", s.Tag))
				}
				{ " " + n(ctx, "{n} sender", "{n} senders", s.From) + ", " + n(ctx, "{n} receiver", "{n} receivers", s.To) + "." }
			</p>
			<div class="stats">
				<div class="stat" hx-get={ countURL(s.Name, s.Role, "sum-"+id) } hx-trigger="load, handoff:run from:body" hx-swap="innerHTML">
					<span class="skeleton"></span>
					<small>{ countLabel(ctx, s.Role) }</small>
				</div>
			</div>
		</div>
	</details>
}

templ Count(n int, role string, thumbs []string, sum string) {
	{ fmt.Sprint(n) }
	<small>{ countLabel(ctx, role) }</small>
	if len(thumbs) > 0 {
		<span class="thumbs">
			for _, t := range thumbs {
				<img src={ templ.SafeURL(t) } alt="" loading="lazy" width="56" height="56"/>
			}
		</span>
	}
	if sum != "" {
		<span id={ sum } class="sum" hx-swap-oob="true"><b data-odo={ sum }>{ fmt.Sprint(n) }</b><small>{ shortLabel(ctx, role) }</small></span>
	}
}

templ LastRun(info *syncer.RunInfo) {
	<section id="lastrun" class="card" hx-get="fragments/lastrun" hx-trigger="handoff:run from:body" hx-swap="outerHTML" aria-live="polite">
		if info == nil {
			<p class="meta">{ t(ctx, "No run yet since the app started.") }</p>
		} else {
			<header>
				<h3>{ t(ctx, "Last run") }</h3>
				<span class="meta">{ loc(ctx).Stamp(info.Finished) } · { reasonLabel(ctx, info.Reason) }</span>
			</header>
			<div class="row">
				<span class="chip ok">{ t(ctx, "{n} handed over", "n", info.Counts.Imported) }</span>
				<span class="chip">{ t(ctx, "{n} already there", "n", info.Counts.Duplicate) }</span>
				<span class={ "chip", warnIf(info.Counts.Refused > 0) }>{ t(ctx, "{n} refused", "n", info.Counts.Refused) }</span>
				<span class={ "chip", badIf(info.Counts.Errors > 0) }>{ t(ctx, "{n} errors", "n", info.Counts.Errors) }</span>
				if info.Counts.DryRun > 0 {
					<span class="chip">{ t(ctx, "{n} dry-run", "n", info.Counts.DryRun) }</span>
				}
			</div>
			if info.Error != "" {
				<p class="meta">{ info.Error }</p>
			}
		}
	</section>
}

// Notice is a page of its own for what stops a person before the dashboard: not signed in, an invitation that is no
// longer valid, a failure. The icon, a large heading and one plain sentence.
templ Notice(title, text string, bad bool) {
	@Layout(title, "") {
		<section class={ "notice-page", templ.KV("bad", bad) }>
			<span class="notice-icon" aria-hidden="true"><img src="static/favicon.svg" alt="" width="56" height="56"/></span>
			<h1>{ title }</h1>
			<p class="lead">{ text }</p>
		</section>
	}
}

templ OfferCard(o OfferView) {
	<article class="card">
		<header>
			<h3>{ o.Name }</h3>
			<span class={ "chip", offerChip(o.State) }>{ offerLabel(ctx, o.State) }</span>
		</header>
		<p class="meta">
			{ t(ctx, "Send photos by adding the tag") } <code class="tag">{ o.Tag }</code> { t(ctx, "to them in Immich.") }
			if o.Owner != "" {
				{ " Offered by " + o.Owner + "." }
			}
		</p>
		if o.Pool {
			<p class="meta"><span class="chip warn">{ t(ctx, "Event pool") }</span> { t(ctx, "Everyone in it sends and receives: every photo you tag goes to everyone else in the pool, and theirs come to you, tagged with who took them. Your originals stay.") }
				if o.Ends != "" {
					{ t(ctx, "It ends {when}.", "when", o.Ends) }
				}
			</p>
		}
		if o.State == "join" || o.State == "approved" || o.State == "request" {
			<p class="row">
				switch o.State {
					case "join", "approved":
						if o.Pool {
							<button class="primary" hx-post="join" hx-vals={ valsJoinPool(o.Name, o.Invite) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ poolConfirm(ctx, o.Name, o.Tag, o.Ends) } data-confirm-title={ t(ctx, "Join the pool {name}?", "name", o.Name) } data-confirm-label={ t(ctx, "Join the pool") }>
								{ t(ctx, "Join the pool") }
							</button>
						} else {
						<span class="meta q">{ t(ctx, "What should happen to your originals?") }</span>
						<button class="primary" hx-post="join" hx-vals={ valsJoin(o.Name, o.Invite, "copy") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ joinConfirm(ctx, o.Name, o.Tag, true) } data-confirm-title={ t(ctx, "Join {name}?", "name", o.Name) } data-confirm-label={ t(ctx, "Join") }>
							{ joinLabel(ctx, o.State, true) }
						</button>
						<button hx-post="join" hx-vals={ valsJoin(o.Name, o.Invite, "move") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ joinConfirm(ctx, o.Name, o.Tag, false) } data-confirm-title={ t(ctx, "Join {name}?", "name", o.Name) } data-confirm-label={ t(ctx, "Join") }>
							{ joinLabel(ctx, o.State, false) }
						</button>
						}
					case "request":
						<button class="primary" hx-post="ask" hx-vals={ valsJoin(o.Name, o.Invite, "") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Ask to join") }</button>
				}
			</p>
		}
	</article>
}

// OwnedRow is a service the person offers: who sends, the limits, the invitation, and (apart) deleting it.
templ OwnedRow(o OwnedView, id string, open bool) {
	<details class="svc card" name="svc" open?={ open }>
		@RowHead(o.Name, policyLabel(ctx, o.Policy)+" \u00b7 "+t(ctx, "you receive"), ownedChips(ctx, o), "sum-"+id)
		<div class="body">
			<p class="meta">
				@templ.Raw(h(ctx, `You receive the photos senders tag <code class="tag">{tag}</code>.`, "tag", o.Tag))
				{ t(ctx, "Nobody can see the key the app uses for your account.") }
			</p>
			if o.Album != "" {
				<p class="meta">
					@templ.Raw(h(ctx, "What arrives is put in the album <strong>{album}</strong> in your Immich account, made when the first photo comes if you do not have it, instead of being tagged inbox.", "album", o.Album))
				</p>
			}
			if o.Broken != "" {
				<p class="meta"><span class="chip bad">{ t(ctx, "Disconnected") }</span> { unpack(ctx, o.Broken) } { t(ctx, "Senders are paused until you reconnect (the button is under Needs you, above).") }</p>
			}
			if len(o.Requests) > 0 {
				<p class="meta"><span class="chip warn">{ t(ctx, "{n} waiting", "n", len(o.Requests)) }</span> { t(ctx, "Approve or decline them under Needs you, above.") }</p>
			}
			<div class="stats">
				<div class="stat" hx-get={ countURL(o.Name, "receiver", "sum-"+id) } hx-trigger="load, handoff:run from:body" hx-swap="innerHTML">
					<span class="skeleton"></span>
					<small>{ countLabel(ctx, "receiver") }</small>
				</div>
			</div>
			if len(o.Members) > 0 {
				<div class="members">
					<span class="meta">{ t(ctx, "Senders") }</span>
					for _, m := range o.Members {
						<span class={ "chip", memberChip(m.State) }>{ m.Name }{ memberSuffix(ctx, m.State, m.Copy) }{ pausedSuffix(ctx, m.Paused) }</span>
						if m.Used != "" {
							<span class="meta">{ m.Used }</span>
						}
					}
				</div>
			} else {
				<p class="meta">{ t(ctx, "Nobody sends to this service yet.") }</p>
			}
			<form class="limits" hx-post="services/limits" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
				<input type="hidden" name="service" value={ o.Name }/>
				<label>{ t(ctx, "Photos per sender per day") } <input name="photos" type="number" min="0" max="1000000" value={ fmt.Sprint(o.LimitPhotos) } class="narrow"/></label>
				<label>{ t(ctx, "MB per sender per day") } <input name="mb" type="number" min="0" max="1000000" value={ fmt.Sprint(o.LimitMB) } class="narrow"/></label>
				<button type="submit">{ t(ctx, "Save limits") }</button>
				<small class="meta">{ t(ctx, "0 means no limit. Photos over the limit wait, tagged, until the day moves on.") }</small>
			</form>
			<form class="limits rules" hx-post="services/rules" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
				<input type="hidden" name="service" value={ o.Name }/>
				<div class="rule-row">
					<label>{ t(ctx, "Hand over only between") } <input name="from" type="time" value={ o.QuietFrom }/> { t(ctx, "and") } <input name="to" type="time" value={ o.QuietTo }/></label>
					<label>{ t(ctx, "Only files larger than (MB) wait for those hours") } <input name="largemb" type="number" min="0" max="1000000" value={ fmt.Sprint(o.QuietLargeMB) } class="narrow"/></label>
				</div>
				<div class="rule-row">
					<label>{ t(ctx, "Accept photos rated") }
						<select name="rating">
							for i := 0; i <= 5; i++ {
								<option value={ fmt.Sprint(i) } selected?={ o.AcceptRating == i }>{ ratingLabel(ctx, i) }</option>
							}
						</select>
					</label>
					<label>{ t(ctx, "Orientation") }
						<select name="orientation">
							<option value="" selected?={ o.AcceptOrient == "" }>{ t(ctx, "Any orientation") }</option>
							<option value="landscape" selected?={ o.AcceptOrient == "landscape" }>{ t(ctx, "Landscape only") }</option>
							<option value="portrait" selected?={ o.AcceptOrient == "portrait" }>{ t(ctx, "Portrait only") }</option>
						</select>
					</label>
					<label>{ t(ctx, "Largest file (MB)") } <input name="maxmb" type="number" min="0" max="1000000" value={ fmt.Sprint(o.AcceptMaxMB) } class="narrow"/></label>
					<label><input name="photos" type="checkbox" value="1" checked?={ o.AcceptPhotos }/> { t(ctx, "Photos only (no videos)") }</label>
				</div>
				<div class="rule-row">
					<button type="submit">{ t(ctx, "Save rules") }</button>
				</div>
				<small class="meta">{ t(ctx, "Outside the hours, photos wait, still tagged, and go when they open; leave the hours empty for any time. The time zone is the app's (TZ). A photo that does not match the rules is not handed over and gets the refused tag. The tagged photo is the one judged: a stack or a live photo goes or stays as one.") }</small>
			</form>
			<form class="limits" hx-post="services/lifetime" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
				<input type="hidden" name="service" value={ o.Name }/>
				if o.DeleteOK {
					<label>{ t(ctx, "Move copies to my trash after (days)") } <input name="days" type="number" min="0" max="3650" value={ fmt.Sprint(o.LifetimeDays) } class="narrow"/></label>
					<button type="submit">{ t(ctx, "Save lifetime") }</button>
					<small class="meta">{ t(ctx, "Photos handed over to this service are moved to your trash, never deleted for good, after this many days, unless you file them in an album or take the inbox tag off. Empty or 0: they stay.") }</small>
				} else {
					<small class="meta">{ t(ctx, "Copies that expire, and taking a hand-over back, are switched off by the administrator (RECEIVER_DELETE).") }</small>
				}
			</form>
			if o.Invite != "" {
				<div class="field">
					<label for={ "inv-" + id }>{ t(ctx, "Invitation link (only people with it can find this service)") }</label>
					<div class="row">
						<input id={ "inv-" + id } class="invite" readonly data-invite={ o.Invite }/>
						<button type="button" class="copy">{ t(ctx, "Copy") }</button>
						<button type="button" class="copy-message" data-for={ "inv-" + id } data-message={ t(ctx, "Hello! Open this link while you are signed in to Immich to join {name} and send me photos: {link}", "name", o.Name, "link", "{link}") }>{ t(ctx, "Copy a message") }</button>
						<button type="button" class="show-qr" data-for={ "inv-" + id } data-alt={ t(ctx, "QR code of the invitation link") }>{ t(ctx, "QR code") }</button>
						<button hx-post="services/invite" hx-vals={ vals("service", o.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The current link will stop working. Continue?") } data-confirm-title={ t(ctx, "Make a new link?") } data-confirm-label={ t(ctx, "New link") }>{ t(ctx, "New link") }</button>
					</div>
					<div class="qr" id={ "qr-inv-" + id } hidden></div>
				</div>
			}
			if o.Pool {
				@PoolCard(o)
			}
			@DigestCard(o.Name, o.Digest, id)
			if o.BridgeStopped != "" {
				<p class="meta"><span class="chip bad">{ t(ctx, "Stopped") }</span> { o.BridgeStopped }</p>
			}
			if o.HasBridge {
				<div class="field">
					<label>{ t(ctx, "Receiving on another server") }</label>
					<p class="meta">
						<strong>{ o.BridgeName }</strong>
						<span class={ "chip", bridgeTone(o.BridgeState) }>{ bridgeStateLabel(o.BridgeState) }</span>
						if o.BridgeVersion != "" {
							Immich { o.BridgeVersion }
						}
						if o.BridgeChecked != "" {
							&middot; { t(ctx, "last checked") } { o.BridgeChecked }
						}
					</p>
					if o.BridgeState == "ok" {
						<p class="meta">
							if o.BridgeTakeBack {
								{ t(ctx, "Taking a hand-over back reaches them: their key may move photos to their trash.") }
							} else {
								{ t(ctx, "Taking a hand-over back does not reach them: their key cannot move photos to their trash, so what they received stays with them.") }
							}
						</p>
					}
					if o.BridgeState != "ok" && o.BridgeNote != "" {
						<p class="meta">{ o.BridgeNote }
							if o.BridgeState == "unreachable" && o.BridgeRetry != "" {
								{ t(ctx, "Tried again at") } { o.BridgeRetry }.
							}
							{ t(ctx, "Photos wait, still tagged, until it works again.") }
						</p>
					}
					<div class="row">
						<button class="danger" hx-post="services/bridge/remove" hx-vals={ vals("service", o.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Stop sending {name} to the receiver on another server? Photos waiting for it then go to you alone. What already arrived there stays there.", "name", o.Name) } data-confirm-title={ t(ctx, "Remove the receiver on another server?") } data-confirm-label={ t(ctx, "Remove") } data-danger="true">{ t(ctx, "Remove") }</button>
					</div>
				</div>
			}
			if o.BridgeOn {
				<div class="field">
					<label>{ t(ctx, "A receiver on another Immich server") }</label>
					<small class="meta">{ t(ctx, "Someone with their own Immich can receive what is tagged for this service too. They get a link, make a key that can only upload and tag, and enter their address. Taking back and expiry do not work on their side.") }</small>
					<div class="row">
						if o.BridgeInvite != "" {
							<input id={ "bri-" + id } class="invite" readonly data-link={ "bridge/" + o.BridgeInvite }/>
							<button type="button" class="copy">{ t(ctx, "Copy") }</button>
						}
						<button hx-post="services/bridge-invite" hx-vals={ vals("service", o.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">
							if o.BridgeInvite != "" {
								{ t(ctx, "New link") }
							} else {
								{ t(ctx, "Invite someone on another server") }
							}
						</button>
					</div>
				</div>
			}
			<p class="row">
				if o.Paused {
					<button class="primary" data-act="resume" hx-post="services/pause" hx-vals={ pauseVals(o.Name, false) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Resume service") }</button>
				} else {
					<button data-act="pause" hx-post="services/pause" hx-vals={ pauseVals(o.Name, true) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Pause this service? Nothing is handed over to you, and photos senders tag stay tagged, until you resume it.") } data-confirm-title={ t(ctx, "Pause this service?") } data-confirm-label={ t(ctx, "Pause") }>{ t(ctx, "Pause service") }</button>
				}
				if o.Invite != "" {
					<button hx-post="services/visibility" hx-vals={ visVals(o.Name, "listed") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "List for everyone") }</button>
				} else {
					<button hx-post="services/visibility" hx-vals={ visVals(o.Name, "invite") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Make invitation-only") }</button>
				}
			</p>
			<div class="danger-zone">
				<span class="meta">{ t(ctx, "Deleting removes the receiver key from your Immich account. Senders stop handing photos to you and are told. Photos already in your library stay.") }</span>
				<button class="danger" hx-post="services/delete" hx-vals={ vals("service", o.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Delete {name}? Its receiver key is removed from your Immich account and senders stop handing photos to you.", "name", o.Name) } data-confirm-title={ t(ctx, "Delete {name}?", "name", o.Name) } data-confirm-label={ t(ctx, "Delete service") } data-danger="true">{ t(ctx, "Delete service") }</button>
			</div>
		</div>
	</details>
}

templ OfferForm(deleteOK bool) {
	<form class="card offer-form" hx-post="services" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button" hx-confirm={ createConfirm(ctx, deleteOK) } data-confirm-title={ t(ctx, "Create this service?") } data-confirm-label={ t(ctx, "Create service") }>
		<p class="meta">{ t(ctx, "Others can then send you photos by tagging them. You decide who may send; each sender decides what happens to their own originals.") }</p>
		<div class="form-grid">
			<div class="field">
				<label for="svc-name">{ t(ctx, "Service name") }</label>
				<input id="svc-name" name="name" required minlength="2" maxlength="40" placeholder={ t(ctx, "Holiday 2026") }/>
			</div>
			<div class="field">
				<label for="svc-tag">{ t(ctx, "Tag senders add") }</label>
				<input id="svc-tag" name="tag" required maxlength="64" placeholder={ t(ctx, "holiday") }/>
			</div>
			<div class="field">
				<label for="svc-policy">{ t(ctx, "Who may send") }</label>
				<select id="svc-policy" name="policy">
					<option value="approval">{ t(ctx, "People I approve") }</option>
					<option value="open">{ t(ctx, "Anyone on this Immich server") }</option>
				</select>
			</div>
			<div class="field">
				<label for="svc-vis">{ t(ctx, "Who can find it") }</label>
				<select id="svc-vis" name="visibility">
					<option value="listed">{ t(ctx, "Everyone on this Immich server") }</option>
					<option value="invite">{ t(ctx, "Only people I send a link to") }</option>
				</select>
			</div>
		</div>
		<div class="field pool-field">
			<label><input name="pool" type="checkbox" value="1"/> { t(ctx, "Event pool: everyone who joins, you too, sends and receives") }</label>
			<small class="meta">{ t(ctx, "For a trip or a party. A photo anyone tags goes to everyone else in the pool, tagged with who took it, and everyone's originals stay where they are. People who join are told so before they do.") }</small>
			<label for="svc-poolends">{ t(ctx, "The pool ends after (days, empty: when I end it)") } <input id="svc-poolends" name="poolends" type="number" min="1" max="366" class="narrow"/></label>
		</div>
		<details class="more">
			<summary>{ t(ctx, "More options") }</summary>
			<div class="form-grid">
				<div class="field">
					<label for="svc-inbox">{ t(ctx, "Tag put on what arrives (default: inbox)") }</label>
					<input id="svc-inbox" name="inbox" maxlength="64" placeholder={ t(ctx, "inbox") }/>
				</div>
				<div class="field">
					<label for="svc-expiry">{ t(ctx, "Days before an unfiled photo loses that tag (default: 30)") }</label>
					<input id="svc-expiry" name="expiry" type="number" min="1" max="3650" placeholder="30"/>
				</div>
				<div class="field wide">
					<label for="svc-album">{ t(ctx, "Put what arrives in this album (optional, instead of the inbox tag)") }</label>
					<input id="svc-album" name="album" maxlength="100" placeholder={ t(ctx, "Holiday 2026") }/>
					<small class="meta">{ t(ctx, "An album of yours with that name; it is made if you do not have one. The key the app uses then also gets permission to find, create and add to albums.") }</small>
				</div>
				<div class="field">
					<label for="svc-lphotos">{ t(ctx, "Most photos each sender may hand over in a day (optional)") }</label>
					<input id="svc-lphotos" name="photos" type="number" min="0" max="1000000" placeholder={ t(ctx, "no limit") }/>
				</div>
				<div class="field">
					<label for="svc-lmb">{ t(ctx, "Most megabytes each sender may hand over in a day (optional)") }</label>
					<input id="svc-lmb" name="mb" type="number" min="0" max="1000000" placeholder={ t(ctx, "no limit") }/>
				</div>
				<small class="meta wide">{ t(ctx, "Photos over a limit wait, tagged, until the day moves on. You can change the limits later.") }</small>
			</div>
		</details>
		<p class="row form-actions"><button class="primary" type="submit">{ t(ctx, "Create service") }</button></p>
	</form>
}

// AdminData is everything the administrator's page shows.
type AdminData struct {
	User     string
	Services []AdminServiceView
	Leftover []AdminMemberView
	Activity []AdminActivityView
	Backup   AdminBackup
	Notify   []NotifyView
	SelfOn   bool // people can join from the page, so there is a store to remove from
	Senders   int  // senders across all services
	Attention int  // services and senders that are paused, limited or disconnected, and people waiting to clean up
}

// NotifyView is a place messages for whoever runs the app go, as the administrator's page lists it (never its address).
type NotifyView struct {
	Name, Format, Kinds string
	People              bool
}

// NotifyResultView is how a destination answered a test.
type NotifyResultView struct {
	Name, Format, Err string
	People            bool
}

// AdminBackup is what the administrator's page says about backups.
type AdminBackup struct {
	Has      bool   // there is a store, so there is something to back up
	Download bool   // the download button is switched on (HANDOFF_ADMIN_BACKUP_DOWNLOAD)
	Every    string // how often, as written in BACKUP_EVERY, or "" when automatic backups are off
	Keep     int
	Folder   string
	Count    int
	Last     string // the newest backup's file name
	LastWhen string
	Failed   string // why the last backup failed, if it did
}

type AdminServiceView struct {
	Name, Tag, Owner, Policy, Album string
	InviteOnly, Copy, FromConfig    bool
	Paused                          bool
	Limit                           string
	Receivers                       int
	Broken                          string
	Members                         []AdminMemberView
}

type AdminMemberView struct {
	LinkID, Name, Email, State, Note, Album string
	Copy, FromConfig                        bool
	Paused                                  bool
}

type AdminActivityView struct{ When, Service, Text, Tone string }

templ AdminPage(d AdminData) {
	@Layout(t(ctx, "Immich Handoff: admin"), d.User) {
		<p id="flash" class="toast" role="status" aria-live="polite"></p>
		<h1>
			@templ.Raw(h(ctx, "Everything on this <em>server</em>"))
		</h1>
		<p class="lead">{ t(ctx, "Every service, who offers it, who sends to it, and whether the connections work.") } <a href="./">{ t(ctx, "Back to your own page") }</a></p>
		<div class="kpis admin-kpis">
			<article class="card kpi"><span class="kpi-label">{ t(ctx, "Services") }</span><span class="num">{ fmt.Sprint(len(d.Services)) }</span><span class="sub">{ t(ctx, "offered on this server") }</span></article>
			<article class="card kpi"><span class="kpi-label">{ t(ctx, "Senders") }</span><span class="num">{ fmt.Sprint(d.Senders) }</span><span class="sub">{ t(ctx, "across all services") }</span></article>
			<article class="card kpi"><span class="kpi-label">{ t(ctx, "Need attention") }</span><span class="num">{ fmt.Sprint(d.Attention) }</span><span class="sub">{ t(ctx, "paused, limited or disconnected") }</span></article>
		</div>
		<p class="meta">{ t(ctx, "Removing something here makes the app forget it and stop handing photos over. It cannot delete anyone's API key: Immich lets only the owner of a key delete it, so the key stays in that person's account until they delete it, and they are told so on their page. Photos are never touched.") }</p>
		<h2>{ t(ctx, "Share this page") }</h2>
		<section class="card">
			<p class="meta">{ t(ctx, "This is the address people use to join. Send it, or put the button in Immich's own header (see the guide on finding this page).") }</p>
			<div class="field">
				<label for="share-page">{ t(ctx, "Address of this page") }</label>
				<div class="row">
					<input id="share-page" class="invite" readonly data-link="./"/>
					<button type="button" class="copy">{ t(ctx, "Copy") }</button>
					<button type="button" class="copy-message" data-for="share-page" data-message={ t(ctx, "Hello! Open this link while you are signed in to Immich to send photos with immich-handoff: {link}", "link", "{link}") }>{ t(ctx, "Copy a message") }</button>
					<button type="button" class="show-qr" data-for="share-page" data-alt={ t(ctx, "QR code of this page's address") }>{ t(ctx, "QR code") }</button>
				</div>
				<div class="qr" id="qr-share-page" hidden></div>
			</div>
		</section>
		<h2>{ t(ctx, "Check the connections") }</h2>
		<section class="card">
			<p class="row">
				<button class="primary" hx-post="admin/check" hx-target="#checkresult" hx-swap="innerHTML" hx-disabled-elt="this" hx-indicator="#checkresult">{ t(ctx, "Check now") }</button>
				<span class="meta">
					@templ.Raw(h(ctx, "The same check as <code>immich-handoff doctor</code>. It only reads."))
				</span>
			</p>
			<pre id="checkresult" class="checkresult" aria-live="polite"></pre>
		</section>
		@AdminNotify(d.Notify)
		<h2>{ t(ctx, "Services") } <span class="count-badge">{ fmt.Sprint(len(d.Services)) }</span></h2>
		if len(d.Services) == 0 {
			<div class="card empty">{ t(ctx, "There are no services yet.") }</div>
		}
		for i, s := range d.Services {
			@AdminServiceCard(s, d.SelfOn, fmt.Sprintf("adm-%d", i), len(d.Services) == 1)
		}
		if len(d.Leftover) > 0 {
			<h2>{ t(ctx, "Waiting to clean up") }</h2>
			<p class="meta">{ t(ctx, "Their service was removed. They still hold a key and a workflow in Immich and see a Clean up button on their page. Nothing is handed over for them.") }</p>
			<section class="card">
				<ul class="events">
					for _, m := range d.Leftover {
						<li>{ m.Name } <span class="meta">{ m.Email }</span></li>
					}
				</ul>
			</section>
		}
		if d.Backup.Has {
			@AdminBackups(d.Backup)
		}
		if len(d.Activity) > 0 {
			<h2>{ t(ctx, "Recent events") }</h2>
			<section class="card timeline-card" aria-label={ t(ctx, "Recent events") }>
				<ol class="timeline">
					for _, a := range d.Activity {
						<li><time>{ a.When }</time><span class={ "dot", a.Tone } aria-hidden="true"></span><span>{ a.Text }</span></li>
					}
				</ol>
			</section>
		}
	}
}

// AdminNotify lists where the app sends its messages for whoever runs it, with a test.
templ AdminNotify(items []NotifyView) {
	<h2>{ t(ctx, "Notifications") }</h2>
	<section class="card">
		if len(items) == 0 {
			<p class="meta">{ t(ctx, "No destination is set, so problems appear in the log and on the pages only. See NOTIFY_URL and NOTIFY_FILE.") }</p>
		} else {
			<ul class="plain">
				for _, it := range items {
					<li><b>{ it.Name }</b> <span class="meta">
						if it.People {
							{ it.Format } · { t(ctx, "mail to the people taking part") }
						} else {
							{ it.Format } · { t(ctx, "takes {kinds}", "kinds", it.Kinds) }
						}
					</span></li>
				}
			</ul>
			<p class="row">
				<button class="primary" hx-post="admin/notify/test" hx-target="#notifyresult" hx-swap="innerHTML" hx-disabled-elt="this" hx-indicator="#notifyresult">{ t(ctx, "Send a test notification") }</button>
				<span class="meta">{ t(ctx, "One message to each destination, whatever it takes. Nothing else is changed.") }</span>
			</p>
			<div id="notifyresult" aria-live="polite"></div>
		}
	</section>
}

// NotifyResults is how each destination answered a test.
templ NotifyResults(results []NotifyResultView) {
	<ul class="plain">
		for _, r := range results {
			<li>
				<b>{ r.Name }</b>
				if r.People {
					<span class="chip">{ t(ctx, "not tested here") }</span> <span class="meta">{ t(ctx, "each person tests their own mail from their page") }</span>
				} else if r.Err == "" {
					<span class="chip ok">{ t(ctx, "delivered") }</span>
				} else {
					<span class="chip bad">{ t(ctx, "failed") }</span> <span class="meta">{ r.Err }</span>
				}
			</li>
		}
	</ul>
}

// AdminBackups is the Backups section: the schedule, the newest backup and, only when it is switched on, the download.
templ AdminBackups(b AdminBackup) {
	<h2>{ t(ctx, "Backups") }</h2>
	<section class="card" id="backups">
		<p>
			if b.Every != "" {
				{ t(ctx, "Automatic backups: every {every}, keeping the newest {keep}, in {folder}.", "every", b.Every, "keep", fmt.Sprint(b.Keep), "folder", b.Folder) }
			} else {
				{ t(ctx, "Automatic backups are off. Backups are made only when you run the backup command.") }
			}
		</p>
		<p class="meta">
			switch {
				case b.Failed != "":
					{ t(ctx, "The last backup failed: {reason}", "reason", b.Failed) }
				case b.Last != "":
					{ t(ctx, "Newest backup: {name}, made {when}.", "name", b.Last, "when", b.LastWhen) }
				default:
					{ t(ctx, "No backup has been made yet.") }
			}
		</p>
		if b.Download {
			<p class="row">
				<button class="primary" data-backup-download="admin/backup/download" hx-post="admin/backup/download" hx-swap="none" hx-disabled-elt="this" hx-confirm={ t(ctx, "The file holds every stored API key, still encrypted, and everyone's name and email. Only download it to keep it somewhere safe.") } data-confirm-title={ t(ctx, "Download a backup?") } data-confirm-label={ t(ctx, "Download") }>{ t(ctx, "Download backup") }</button>
				<span class="meta">{ t(ctx, "A copy of the app's data, made now. It is written to the recent events.") }</span>
			</p>
		} else {
			<p class="meta">
				@templ.Raw(h(ctx, "Downloading a backup from this page is off. To turn it on, and what to know first, see <a href=\"{url}\" target=\"_blank\" rel=\"noopener\">Backups</a>.", "url", backupDocsURL))
			</p>
		}
	</section>
}

// AdminServiceCard is one service for the administrator, as a row that opens to its facts, senders and (apart) its removal.
templ AdminServiceCard(s AdminServiceView, removable bool, id string, open bool) {
	<details class="svc card" name="adm" open?={ open }>
		<summary>
			<span class={ "badge", hueClass(s.Name) } aria-hidden="true">{ initial(s.Name) }</span>
			<span class="title"><b>{ s.Name }</b><span>{ adminPolicy(ctx, s.Policy) }{ adminOwner(s.Owner) }</span></span>
			<span class="chips">
				if s.InviteOnly {
					<span class="chip">{ t(ctx, "Invitation only") }</span>
				}
				if s.FromConfig {
					<span class="chip">{ t(ctx, "From configuration") }</span>
				}
				if s.Broken != "" {
					<span class="chip bad">{ t(ctx, "Disconnected") }</span>
				}
				if s.Paused {
					<span class="chip warn">{ t(ctx, "Paused") }</span>
				}
			</span>
			<span class="sum"><b>{ fmt.Sprint(len(s.Members)) }</b><small>{ n(ctx, "sender", "senders", len(s.Members)) }</small></span>
			<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
		</summary>
		<div class="body">
			<p class="meta">
				@templ.Raw(h(ctx, `Tag <code class="tag">{tag}</code>.`, "tag", s.Tag))
				if s.Limit != "" {
					{ t(ctx, "Limit per sender: {limit}.", "limit", s.Limit) }
				}
				if s.Owner != "" {
					{ t(ctx, "Offered by {name}.", "name", s.Owner) }
				}
				{ n(ctx, "{n} receiver", "{n} receivers", s.Receivers) + "." }
				if s.Copy {
					{ t(ctx, "Originals are kept.") }
				} else {
					{ t(ctx, "Originals are moved to the sender's trash.") }
				}
				if s.Album != "" {
					@templ.Raw(h(ctx, "Arrivals go to the album <strong>{album}</strong>.", "album", s.Album))
				}
			</p>
			if s.Broken != "" {
				<p class="meta"><span class="chip bad">{ t(ctx, "Disconnected") }</span> { unpack(ctx, s.Broken) }</p>
			}
			if len(s.Members) == 0 {
				<p class="meta">{ t(ctx, "No senders yet.") }</p>
			}
			<ul class="member-list">
				for _, m := range s.Members {
					<li>
						<span class={ "chip", memberChip(m.State) }>{ m.Name }</span>
						<span class="member-facts">
							if m.Email != "" {
								<span class="meta">{ m.Email }</span>
							}
							<span class="meta">{ memberSuffix(ctx, m.State, m.Copy) }{ pausedSuffix(ctx, m.Paused) }</span>
							if m.Album != "" {
								<span class="meta">{ t(ctx, "album {name}", "name", m.Album) }</span>
							}
							if m.FromConfig {
								<span class="meta">{ t(ctx, "from configuration") }</span>
							}
							if m.Note != "" {
								<span class="meta member-note">{ unpack(ctx, m.Note) }</span>
							}
						</span>
						if m.LinkID != "" && removable {
							<button class="danger" hx-post="admin/members/remove" hx-vals={ vals("link", m.LinkID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Remove {name} from {service}? The app stops handing over their photos. Their API key stays in their Immich account until they delete it; they are told on their page.", "name", m.Name, "service", s.Name) } data-confirm-title={ t(ctx, "Remove this member?") } data-confirm-label={ t(ctx, "Remove") } data-danger="true">{ t(ctx, "Remove") }</button>
						}
					</li>
				}
			</ul>
			if !s.FromConfig && removable {
				<div class="danger-zone">
					<span class="meta">{ t(ctx, "Removing the service stops everything handed over to it. The owner's receiver key stays in their Immich account until they delete it; members and the owner are told.") }</span>
					<button class="danger" hx-post="admin/services/remove" hx-vals={ vals("service", s.Name) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Remove the service {name}? Nothing is handed over any more. The owner's receiver key stays in their Immich account until they delete it; members and owner are told.", "name", s.Name) } data-confirm-title={ t(ctx, "Remove this service?") } data-confirm-label={ t(ctx, "Remove service") } data-danger="true">{ t(ctx, "Remove this service") }</button>
				</div>
			}
		</div>
	</details>
}

// NeedCard is one card of the "Needs you" strip.
templ NeedCard(n NeedView) {
	<article class={ "card", "need", n.Tone }>
		<b><span class={ "chip", n.Tone }>{ n.Chip }</span> { n.Title }</b>
		<p class="meta">{ n.Text }</p>
		if len(n.Actions) > 0 {
			<p class="row">
				for _, a := range n.Actions {
					if a.Confirm != "" {
						<button class={ primaryIf(a.Primary) } { keyAttr(a.Key)... } hx-post={ a.Path } hx-vals={ a.Vals } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ a.Confirm } data-confirm-title={ a.Label + "?" } data-confirm-label={ a.Label }>{ a.Label }</button>
					} else {
						<button class={ primaryIf(a.Primary) } { keyAttr(a.Key)... } hx-post={ a.Path } hx-vals={ a.Vals } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ a.Label }</button>
					}
				}
			</p>
		}
	</article>
}

// Numbers is the section of three numbers and the week's chart. It asks for itself again whenever a pass finishes.
templ Numbers(n NumbersView) {
	<section id="numbers" class="numbers" hx-get="fragments/numbers" hx-trigger={ numbersTrigger(n) } hx-swap="outerHTML" aria-live="polite">
		<div class="kpis">
			<article class="card kpi wide">
				<span class="kpi-label">{ t(ctx, "Handed over, last 7 days") }</span>
				<span class="num" data-odo="week">
					if n.Loading {
						<span class="skeleton"></span>
					} else {
						{ fmt.Sprint(n.Week) }
					}
				</span>
				if !n.Loading {
					<svg class="spark" viewBox="0 0 300 56" preserveAspectRatio="none" role="img" aria-label={ sparkLabel(ctx, n.Days) }>
						<defs>
							<linearGradient id="sparkfill" x1="0" x2="0" y1="0" y2="1">
								<stop offset="0" stop-color="currentColor" stop-opacity=".35"></stop>
								<stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
							</linearGradient>
						</defs>
						<path d={ sparkArea(n.Days) } fill="url(#sparkfill)"></path>
						<path class="spark-line" d={ sparkLine(n.Days) } fill="none"></path>
						<circle class="spark-dot" cx={ sparkEndX() } cy={ sparkEndY(n.Days) } r="4.5"></circle>
					</svg>
					<ol class="days">
						for _, d := range n.Days {
							<li><b>{ fmt.Sprint(d.N) }</b><span>{ d.Label }</span></li>
						}
					</ol>
					if n.Week == 0 {
						<span class="sub">{ t(ctx, "Nothing handed over yet this week.") }</span>
					}
				}
			</article>
			if n.Sender || n.Loading {
				<article class="card kpi">
					<span class="kpi-label">{ t(ctx, "Waiting to go") }</span>
					<span class="num" data-odo="waiting">
						if n.Loading {
							<span class="skeleton"></span>
						} else {
							{ fmt.Sprint(n.Waiting) }
						}
					</span>
					<span class="sub">{ t(ctx, "tagged, still to be handed over") }</span>
				</article>
			}
			if n.Receiver || n.Loading {
				<article class="card kpi">
					<span class="kpi-label">{ t(ctx, "In your inbox") }</span>
					<span class="num" data-odo="inbox">
						if n.Loading {
							<span class="skeleton"></span>
						} else {
							{ fmt.Sprint(n.Inbox) }
						}
					</span>
					<span class="sub">{ t(ctx, "arrived and not yet filed") }</span>
				</article>
			}
		</div>
	</section>
}

// Guide is the first-run guide: a ring that fills as the steps are done.
templ Guide(g GuideView) {
	<h2>{ t(ctx, "Get started") }</h2>
	<section class="card guide" aria-label={ t(ctx, "Getting started") }>
		<div class={ "ring", fmt.Sprintf("r%d", g.Done) } role="img" aria-label={ t(ctx, "{done} of {total} steps done", "done", g.Done, "total", len(g.Steps)) }>
			<span>{ fmt.Sprintf("%d/%d", g.Done, len(g.Steps)) }</span>
		</div>
		<div>
			<h3>{ g.NextStep }</h3>
			<ol class="steps">
				for _, s := range g.Steps {
					<li class={ doneIf(s.Done) }><span class="dot" aria-hidden="true">{ tickIf(s.Done) }</span> { s.Text }</li>
				}
			</ol>
			<p class="row"><button hx-post="guide/dismiss" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Hide this guide") }</button></p>
		</div>
	</section>
}

// Scene is the live scene: for each service a stage with a lane per sender and a gate into the receiving library. The
// script (scene.ts) animates it from the live events; without script or motion the same facts are in the lane labels,
// the counter and the log. It asks for itself again when the page learns it missed something.
templ Scene(stages []SceneStage) {
	<section id="scene" class="scene" hx-get="fragments/scene" hx-trigger="scene:refresh from:body" hx-swap="outerHTML" aria-label={ t(ctx, "Live hand-overs") }>
		<p class="meta scene-offline" data-offline hidden>{ t(ctx, "Live updates are off for now: the connection to the app dropped. They come back by themselves; the numbers above still refresh when you reload the page.") }</p>
		for _, st := range stages {
			<article class="card stage" data-stage data-service={ st.Service } data-dir={ sceneDir(st) }>
				<header>
					<h3>{ st.Service }</h3>
					<span class="meta">{ st.Where }</span>
				</header>
				<div class="stage-body">
					<div class="lanes">
						for _, l := range st.Lanes {
							<div class="lane" data-lane data-sender={ l.Name } data-state={ l.State } data-paused={ l.PausedBy }>
								<div class="lane-who">
									<span class="lane-ring" aria-hidden="true"><span class={ "avatar", hueClass(l.Name) }>{ initial(l.Name) }</span></span>
									<div>
										<b>{ l.Name }</b>
										<span class="lane-state" data-lane-state>{ laneLabel(ctx, l) }</span>
									</div>
								</div>
								<div class="track" data-track></div>
							</div>
						}
					</div>
					<aside class="gate" aria-label={ t(ctx, "Arrivals in {service}", "service", st.Service) }>
						<div class="landed" data-landed aria-hidden="true"></div>
						<div>
							<span class="big" data-arrived data-odo={ "arrived:" + st.Service }>0</span>
							<span class="cl">{ t(ctx, "arrived while you watch") }</span>
						</div>
					</aside>
				</div>
			</article>
		}
		<ul class="scene-log" data-log aria-label={ t(ctx, "What just happened") }><li class="meta" data-empty>{ t(ctx, "Nothing yet. What happens next shows here.") }</li></ul>
		<p class="visually-hidden" role="status" aria-live="polite" data-announce></p>
	</section>
}

// InvitePage is where an invitation link leads: the invited service, large, and what joining means, and nothing else.
templ InvitePage(d DashboardData) {
	@Layout("Immich Handoff", d.User) {
		<p id="flash" class="toast" role="status" aria-live="polite"></p>
		if d.TagsOff {
			@TagsNotice()
		}
		<div id="gated" { gate(d.TagsOff)... }>
			<section class="invite-hero">
				<h1>
					@templ.Raw(h(ctx, "You are invited to <em>{name}</em>", "name", d.Invited.Name))
				</h1>
				<p class="lead">
					if d.Invited.Owner != "" {
						{ d.Invited.Owner } { t(ctx, "offers this service.") }
					}
					{ t(ctx, "Photos you tag in Immich are handed over to them. You choose what happens to your own originals, and you can stop at any time.") }
				</p>
			</section>
			<div class="invite-card">
				@OfferCard(*d.Invited)
			</div>
			<p class="meta"><a href="../">{ t(ctx, "Not now: open your own page") }</a></p>
		</div>
	}
}

// DropBoxSection is where a person makes and looks after their drop boxes.
templ DropBoxSection(boxes []DropBoxView, templates []TemplateView) {
	<h2>{ t(ctx, "Drop boxes") }</h2>
	<p class="meta">{ t(ctx, "A drop box is a link for people who do not have Immich: relatives at a wedding, guests at an event. They open it, choose photos and send them. They see nothing of your library, not even what others sent. What arrives goes into your library under a tag of its own, to look through before you file it.") }</p>
	for i, b := range boxes {
		@DropBoxRow(b, fmt.Sprintf("drop-%d", i), len(boxes) == 1)
	}
	<details class="offer">
		<summary>{ t(ctx, "Make a drop box") }</summary>
		@DropBoxForm()
	</details>
	<details class="offer">
		<summary>{ t(ctx, "Start from a template") }</summary>
		<div class="card offer-form">
			<p class="meta">{ t(ctx, "A template keeps the settings of a box (limits, message, filing, look), not its link, password or guests. Give the new box a name, and when it should open and close if you want.") }</p>
			for _, tp := range templates {
				<form class="limits" hx-post="dropbox/fromtemplate" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
					<input type="hidden" name="service" value={ tp.ID }/>
					<b>{ tp.Name }</b> <span class="meta">{ tp.Summary }</span>
					<label>{ t(ctx, "Name of the new box") } <input name="name" required minlength="2" maxlength="60"/></label>
					<label>{ t(ctx, "Opens at") } <input name="opens" type="datetime-local"/></label>
					<label>{ t(ctx, "Closes at") } <input name="closes" type="datetime-local"/></label>
					<button class="primary" type="submit">{ t(ctx, "Make drop box") }</button>
					if !tp.Builtin {
						<button type="button" hx-post="dropbox/template/delete" hx-vals={ vals("service", tp.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Delete the template {name}?", "name", tp.Name) } data-confirm-title={ t(ctx, "Delete the template?") } data-confirm-label={ t(ctx, "Delete template") } data-danger="true">{ t(ctx, "Delete template") }</button>
					}
				</form>
			}
		</div>
	</details>
}

templ DropBoxRow(b DropBoxView, id string, open bool) {
	<details class="svc card" name="svc" open?={ open }>
		<summary>
			<span class={ "badge", hueClass(b.Name) } aria-hidden="true">{ initial(b.Name) }</span>
			<span class="title"><b>{ b.Name }</b><span>{ dropStateLabel(ctx, b.State) }</span></span>
			<span class="chips">
				for _, c := range dropChips(ctx, b) {
					<span class={ "chip", c.Tone }>{ c.Text }</span>
				}
			</span>
			<span class="sum">{ dropCount(ctx, b) }</span>
			<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
		</summary>
		<div class="body">
			if b.State == "revoked" {
				<p class="meta">{ t(ctx, "This drop box was revoked: its link no longer works and its key is gone from your Immich account. The photos it received are in your library. This log disappears after a month.") }</p>
			} else {
				if b.Message != "" {
					<p class="meta">{ b.Message }</p>
				}
				<p class="meta">{ b.Limits }</p>
				if b.Summary != "" {
					<p class="meta"><b>{ t(ctx, "So far") }</b> { b.Summary }</p>
				}
				if b.Opens != "" {
					<p class="meta"><span class="chip">{ t(ctx, "Not open yet") }</span> { t(ctx, "It opens {when}.", "when", b.Opens) }</p>
				}
				if b.Ends != "" {
					<p class="meta">{ t(ctx, "The link stops working {when}.", "when", b.Ends) }</p>
				}
				if b.Album != "" || b.ExtraTag != "" {
					<p class="meta">
						{ t(ctx, "Filed on arrival:") }
						if b.Album != "" {
							{ t(ctx, "in the album {album}", "album", b.Album) }
						}
						if b.ExtraTag != "" {
							{ t(ctx, "with the tag {tag}", "tag", b.ExtraTag) }
						}
					</p>
				}
				if b.Note != "" {
					<p class="meta"><span class="chip warn">{ t(ctx, "Paused") }</span> { unpack(ctx, b.Note) } { t(ctx, "Look at the log below, then resume it when you are happy.") }</p>
				}
				if b.Role != "owner" {
					<p class="meta">
						if b.Manage {
							{ t(ctx, "You help with this drop box: you can approve photos, pause it and extend it.") }
						} else {
							{ t(ctx, "You can see this drop box and its log.") }
						}
						<button hx-post="dropbox/host/remove" hx-vals={ hostVals(b.ID, "") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Stop helping with {name}?", "name", b.Name) } data-confirm-title={ t(ctx, "Stop helping?") } data-confirm-label={ t(ctx, "Stop helping") }>{ t(ctx, "Stop helping") }</button>
					</p>
				}
				if b.Token != "" {
					<div class="field">
						<label for={ "drop-" + id }>{ t(ctx, "Link for guests (anyone who has it can send photos)") }</label>
						<div class="row">
							<input id={ "drop-" + id } class="invite" readonly data-link={ "drop/" + b.Token }/>
							<button type="button" class="copy">{ t(ctx, "Copy") }</button>
							<button type="button" class="copy-message" data-for={ "drop-" + id } data-message={ t(ctx, "Hello! Please send me your photos of {name} here, no account needed: {link}", "name", b.Name, "link", "{link}") }>{ t(ctx, "Copy a message") }</button>
							<button type="button" class="show-qr" data-for={ "drop-" + id } data-alt={ t(ctx, "QR code of the drop box link") }>{ t(ctx, "QR code") }</button>
						</div>
						<div class="qr" id={ "qr-drop-" + id } hidden></div>
					</div>
				}
				if b.Manage {
					<p class="row">
						if b.State == "paused" {
							<button class="primary" data-act="resume" hx-post="dropbox/pause" hx-vals={ pauseVals(b.ID, false) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Resume") }</button>
						} else if b.State == "open" {
							<button data-act="pause" hx-post="dropbox/pause" hx-vals={ pauseVals(b.ID, true) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Pause") }</button>
						}
						if b.CanExtend {
							<button data-act="extend" hx-post="dropbox/extend" hx-vals={ extendVals(b.ID, 1) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Extend by a day") }</button>
							<button data-act="extend" hx-post="dropbox/extend" hx-vals={ extendVals(b.ID, 7) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Extend by a week") }</button>
						}
					</p>
				}
				if b.Manage {
					<div class="field">
						<label>{ t(ctx, "More ways in") }</label>
						if b.Short != "" {
							<div class="row">
								<input id={ "dropshort-" + id } class="invite" readonly data-link={ "d/" + b.Short }/>
								<button type="button" class="copy">{ t(ctx, "Copy") }</button>
								<button type="button" class="show-qr" data-for={ "dropshort-" + id } data-alt={ t(ctx, "QR code of the short link") }>{ t(ctx, "QR code") }</button>
								<button hx-post="dropbox/short" hx-vals={ shortVals(b.ID, false) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The short link stops working. The long link and anything printed with it keep working.") } data-confirm-title={ t(ctx, "Remove the short link?") } data-confirm-label={ t(ctx, "Remove") }>{ t(ctx, "Remove short link") }</button>
							</div>
							<div class="qr" id={ "qr-dropshort-" + id } hidden></div>
							<p class="meta">{ t(ctx, "A short link is easier to type and easier to guess than the long one. Use a password for a box that must stay private.") }</p>
						} else {
							<p class="row"><button hx-post="dropbox/short" hx-vals={ shortVals(b.ID, true) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Make a short link") }</button></p>
						}
						<p class="row">
							<a class="button" href={ templ.SafeURL("dropbox/card/" + b.ID) } target="_blank" rel="noopener">{ t(ctx, "Printable card with a QR code") }</a>
							if b.Short != "" {
								<a class="button" href={ templ.SafeURL("dropbox/card/" + b.ID + "?way=short") } target="_blank" rel="noopener">{ t(ctx, "Card with the short link") }</a>
							}
							if b.Owner {
								<button hx-post="dropbox/renew" hx-vals={ vals("service", b.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The current long link, and every card printed with it, stops working. Continue?") } data-confirm-title={ t(ctx, "Make a new long link?") } data-confirm-label={ t(ctx, "New long link") }>{ t(ctx, "New long link") }</button>
							}
						</p>
					</div>
					if b.MailOn {
						<div class="field">
							<label>{ t(ctx, "Photos by email") }</label>
							if b.MailAddress != "" {
								<div class="row">
									<input id={ "dropmail-" + id } class="invite" readonly value={ b.MailAddress }/>
									<button type="button" class="copy">{ t(ctx, "Copy") }</button>
									<button hx-post="dropbox/mail" hx-vals={ mailVals(b.ID, false) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The address stops working. Photos already received are kept.") } data-confirm-title={ t(ctx, "Remove the email address?") } data-confirm-label={ t(ctx, "Remove") }>{ t(ctx, "Remove email address") }</button>
								</div>
								<p class="meta">{ t(ctx, "Anyone who knows this address can send photos to the box, like the link. Only photos and videos are taken, under the box's limits and approval; the rest of a mail is dropped and nobody gets a reply.") }</p>
							} else if b.MailLocked {
								<p class="meta">{ t(ctx, "A box with a password cannot take photos by email: nobody can type the password into a mail.") }</p>
							} else {
								<p class="row"><button hx-post="dropbox/mail" hx-vals={ mailVals(b.ID, true) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Give this box an email address") }</button></p>
							}
						</div>
					}
					<details class="more">
						<summary>{ t(ctx, "The look of the guest page") }</summary>
						<form class="limits" hx-post="dropbox/look" hx-encoding="multipart/form-data" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
							<input type="hidden" name="service" value={ b.ID }/>
							<label>{ t(ctx, "Colour") } <input name="accent" value={ b.Accent } maxlength="7" placeholder="#4250af" pattern="#[0-9a-fA-F]{6}" class="narrow"/></label>
							<label>{ t(ctx, "Language") }
								<select name="lang">
									<option value="" selected?={ b.Lang == "" }>{ t(ctx, "The guest's own") }</option>
									for _, l := range languages() {
										<option value={ string(l) } selected?={ b.Lang == string(l) }>{ langName(l) }</option>
									}
								</select>
							</label>
							<label>{ t(ctx, "Shrink photos larger than") }
								<select name="maxdim">
									for _, v := range []int{0, 1600, 2400, 4000} {
										<option value={ fmt.Sprint(v) } selected?={ b.MaxDim == v }>{ dimLabel(ctx, v) }</option>
									}
								</select>
							</label>
							<label>{ t(ctx, "Title guests see (optional, otherwise the box's name)") } <input name="title" maxlength="60" value={ b.Title } placeholder={ b.Name }/></label>
							<label>{ t(ctx, "Logo (JPEG, PNG or WebP, up to 300 KB)") } <input name="logo" type="file" accept="image/jpeg,image/png,image/webp"/></label>
							if b.HasLogo {
								<label><input name="nologo" type="checkbox" value="1"/> { t(ctx, "Remove the logo") }</label>
							}
							<label>{ t(ctx, "Cover photo (JPEG, PNG or WebP, up to 900 KB)") } <input name="cover" type="file" accept="image/jpeg,image/png,image/webp"/></label>
							if b.HasCover {
								<label><input name="nocover" type="checkbox" value="1"/> { t(ctx, "Remove the cover photo") }</label>
							}
							<button type="submit">{ t(ctx, "Save the look") }</button>
							<small class="meta">{ t(ctx, "Shrinking happens in the guest's browser, so a photo loses its metadata (date, place) when it is shrunk; a photo that cannot be shrunk there is sent as it is. Leave it off to keep every photo exactly as it was taken.") }</small>
						</form>
					</details>
				}
				if b.Owner {
					<details class="more" data-event>
						<summary>{ t(ctx, "The event: what is kept afterwards") }</summary>
						<form class="limits" hx-post="dropbox/event" hx-vals={ vals("service", b.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
							<div class="field">
								<label for={ "keep-" + b.ID }>{ t(ctx, "Keep what guests leave for (days after it ends)") }</label>
								<input id={ "keep-" + b.ID } name="keepdays" type="number" min="0" max="3650" value={ fmt.Sprint(b.KeepDays) }/>
							</div>
							<label class="wide"><input name="gallery" type="checkbox" value="1" checked?={ b.Gallery }/> { t(ctx, "Guests may look at the photos and heart them") }</label>
							<label class="wide"><input name="gallerydownload" type="checkbox" value="1" checked?={ b.GalleryDownload }/> { t(ctx, "and download them") }</label>
							<label class="wide"><input name="gallerynames" type="checkbox" value="1" checked?={ b.GalleryNames }/> { t(ctx, "and see who sent each photo (the page asks guests for a name)") }</label>
							<p class="row form-actions"><button type="submit">{ t(ctx, "Save") }</button></p>
						</form>
						<small class="meta">{ t(ctx, "Every guest with the link then sees every photo the box has kept, not only their own. Photos waiting for your approval are never shown. The box's key gets permission to view pictures, and to download if you allow it.") }</small>
						if b.KeepUntil != "" {
							<small class="meta">{ t(ctx, "What guests left with the box (their names, their hearts, the gallery) goes on {when}. The photos in your library stay.", "when", b.KeepUntil) }</small>
						} else {
							<small class="meta">{ t(ctx, "0 keeps it until you revoke the box. The photos in your library always stay.") }</small>
						}
					</details>
					<details class="more">
						<summary>{ t(ctx, "Templates and copies") }</summary>
						<form class="limits" hx-post="dropbox/template" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
							<input type="hidden" name="service" value={ b.ID }/>
							<label>{ t(ctx, "Keep these settings as a template named") } <input name="name" required minlength="2" maxlength="60"/></label>
							<button type="submit">{ t(ctx, "Save template") }</button>
						</form>
						<form class="limits" hx-post="dropbox/duplicate" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
							<input type="hidden" name="service" value={ b.ID }/>
							<label>{ t(ctx, "Make a copy of this box named") } <input name="name" required minlength="2" maxlength="60"/></label>
							<label>{ t(ctx, "Opens at") } <input name="opens" type="datetime-local"/></label>
							<label>{ t(ctx, "Closes at") } <input name="closes" type="datetime-local"/></label>
							<button type="submit">{ t(ctx, "Make a copy") }</button>
						</form>
					</details>
				}
				if b.Manage {
					<details class="more">
						<summary>{ t(ctx, "Shot list and message to the host") }</summary>
						<form class="limits" hx-post="dropbox/extras" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
							<input type="hidden" name="service" value={ b.ID }/>
							<label>{ t(ctx, "Shot list: what guests are asked to photograph, one per line") }<textarea name="prompts" rows="4">{ b.PromptsText }</textarea></label>
							<label><input name="required" type="checkbox" value="1" checked?={ b.PromptRequired }/> { t(ctx, "Every photo must say which one it is for") }</label>
							<label><input name="guestbook" type="checkbox" value="1" checked?={ b.GuestBook }/> { t(ctx, "Message to the host: guests may leave a message, with their name, and a voice note") }</label>
							<button type="submit">{ t(ctx, "Save") }</button>
							<small class="meta">{ t(ctx, "Photos for a prompt are also tagged with it in your library, under the box's inbox tag, so Immich lists them together. Guests see the list with a tick on what already has a photo. Changing the list never changes photos already tagged.") }</small>
						</form>
					</details>
				}
				if len(b.Prompts) > 0 {
					<h3>{ t(ctx, "Shot list") }</h3>
					<ul class="plain">
						for _, p := range b.Prompts {
							<li><span class={ "chip", templ.KV("ok", p.Files > 0) }>{ n(ctx, "{n} photo", "{n} photos", p.Files) }</span> { p.Text }</li>
						}
					</ul>
				}
				if b.GuestBook && b.Manage {
					<h3>{ t(ctx, "Messages to the host") } <span class="count-badge">{ fmt.Sprint(len(b.Messages)) }</span></h3>
					if len(b.Messages) == 0 {
						<p class="meta">{ t(ctx, "Nothing here yet. Messages and voice notes guests leave appear here, for you and your co-hosts only. They are kept in this app's own data file, not in Immich.") }</p>
					} else {
						<p class="row"><a class="button" href={ templ.SafeURL("dropbox/guestbook/" + b.ID) }>{ t(ctx, "Download the messages") }</a></p>
					}
					<ul class="plain guestbook">
						for _, m := range b.Messages {
							<li>
								<span class="meta">{ messageAuthor(ctx, m.Name) } · { m.When }</span>
								if m.Text != "" {
									<span>{ m.Text }</span>
								}
								if m.HasAudio {
									<audio controls preload="none" src={ "dropbox/voice/" + m.ID }></audio>
								}
								if m.Text != "" {
									<button hx-post="dropbox/message/wall" hx-vals={ wallMsgVals(m.ID, !m.OnWall) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">
										if m.OnWall {
											{ t(ctx, "Hide from the wall") }
										} else {
											{ t(ctx, "Show on the wall") }
										}
									</button>
								}
								<button hx-post="dropbox/message/delete" hx-vals={ vals("service", m.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Remove this message? It cannot be got back.") } data-confirm-title={ t(ctx, "Remove the message?") } data-confirm-label={ t(ctx, "Remove") } data-danger="true">{ t(ctx, "Remove") }</button>
							</li>
						}
					</ul>
				} else if b.GuestBook {
					<p class="meta">{ t(ctx, "This box takes messages to the host. Only the people who manage it can read them.") }</p>
				}
				if b.Manage {
					<h3>{ t(ctx, "Wall") }</h3>
					if b.WallToken != "" {
						<div class="field">
							<label for={ "wall-" + id }>{ t(ctx, "Link for a screen (shows the photos as they arrive; no sign-in)") }</label>
							<div class="row">
								<input id={ "wall-" + id } class="invite" readonly data-link={ "wall/" + b.WallToken }/>
								<button type="button" class="copy">{ t(ctx, "Copy") }</button>
								<button type="button" class="show-qr" data-for={ "wall-" + id } data-alt={ t(ctx, "QR code of the wall link") }>{ t(ctx, "QR code") }</button>
								<a class="button" href={ templ.SafeURL("wall/" + b.WallToken) } target="_blank" rel="noopener">{ t(ctx, "Open the wall") }</a>
								<a class="button" href={ templ.SafeURL("wall/" + b.WallToken + "?mode=grid") } target="_blank" rel="noopener">{ t(ctx, "As a grid") }</a>
								<a class="button" href={ templ.SafeURL("wall/" + b.WallToken + "?mode=collage") } target="_blank" rel="noopener">{ t(ctx, "As a collage") }</a>
							</div>
							<div class="qr" id={ "qr-wall-" + id } hidden></div>
						</div>
						if b.Owner {
							<p class="row">
								<button hx-post="dropbox/wall" hx-vals={ wallVals(b.ID, true) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The current wall link stops working. Continue?") } data-confirm-title={ t(ctx, "Make a new wall link?") } data-confirm-label={ t(ctx, "New wall link") }>{ t(ctx, "New wall link") }</button>
								<button class="danger" hx-post="dropbox/wall/stop" hx-vals={ vals("service", b.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The wall stops showing photos at once.") } data-confirm-title={ t(ctx, "Stop the wall?") } data-confirm-label={ t(ctx, "Stop the wall") } data-danger="true">{ t(ctx, "Stop the wall") }</button>
							</p>
						}
					} else if b.Owner {
						<p class="meta">{ t(ctx, "A wall shows the photos full screen, one after another, as they arrive, on a TV or a projector. The screen opens its own link and holds nobody's sign-in. Photos waiting for approval, rejected ones and ones guests took back never show. To show pictures the box's key also gets permission to view photos, which is added with your sign-in and taken off when you stop the wall.") }</p>
						<p class="row"><button class="primary" hx-post="dropbox/wall" hx-vals={ wallVals(b.ID, false) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Start a wall") }</button></p>
					} else {
						<p class="meta">{ t(ctx, "No wall has been started. Only the owner starts one.") }</p>
					}
				}
				if b.Owner {
					<h3>{ t(ctx, "Best-of") }</h3>
					if b.Highlight != nil && b.Highlight.Status == "running" {
						<p class="meta"><span class="chip warn">{ t(ctx, "Working") }</span> { t(ctx, "Looking at the photos: {done} of {total}. Reload the page to see how far it is.", "done", b.Highlight.Done, "total", b.Highlight.Total) }</p>
					} else if b.Highlight != nil && b.Highlight.Status == "failed" {
						<p class="meta"><span class="chip bad">{ t(ctx, "Failed") }</span> { b.Highlight.Note }</p>
					} else if b.Highlight != nil && b.Highlight.Status == "done" {
						<p class="meta">
							<span class="chip ok">{ t(ctx, "Done") }</span>
							{ t(ctx, "{kept} of {total} photos kept in the album {album} ({how}), made {when}. Nothing was deleted.", "kept", b.Highlight.Kept, "total", b.Highlight.Total, "album", b.Highlight.Album, "how", strictnessLabel(ctx, b.Highlight.Strictness), "when", b.Highlight.When) }
						</p>
						if len(b.Highlight.Excluded) > 0 {
							<details class="more">
								<summary>{ t(ctx, "Why {n} photos were left out", "n", b.Highlight.OutCount) }</summary>
								<ul class="plain">
									for _, x := range b.Highlight.Excluded {
										<li><b>{ x.Name }</b> <span class="meta">{ x.Reason } { x.Detail }</span></li>
									}
								</ul>
							</details>
						}
					}
					<form class="limits" hx-post="dropbox/highlights" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
						<input type="hidden" name="service" value={ b.ID }/>
						<label>{ t(ctx, "How much to leave out") }
							<select name="strictness">
								for _, s := range []string{"relaxed", "normal", "strict"} {
									<option value={ s } selected?={ b.Highlight != nil && b.Highlight.Strictness == s || b.Highlight == nil && s == "normal" }>{ strictnessLabel(ctx, s) }</option>
								}
							</select>
						</label>
						<button type="submit">
							if b.Highlight != nil && b.Highlight.Status == "done" {
								{ t(ctx, "Make it again") }
							} else {
								{ t(ctx, "Make a best-of") }
							}
						</button>
						<small class="meta">{ t(ctx, "Looks at every photo in this box and leaves out the ones that are too dark, too bright or blurred, and all but the sharpest of shots of the same moment (within an hour). The rest go into an album of yours called \"{name} best of\". It never deletes or changes a photo, and running it again with another setting corrects the album, leaving anything else you put in it alone. Photos Immich keeps only as WebP previews cannot be looked at, so they are kept.", "name", b.Name) }</small>
					</form>
					<h3>{ t(ctx, "Loved by guests") }</h3>
					<p class="meta">{ t(ctx, "Puts the photos guests gave hearts, and the ones a moderator pinned, in an album of yours called \"{box} loved by guests\": the pinned first, then the most hearts, at most a hundred, never a hidden one. Run it again to correct the album; what you added yourself stays.", "box", b.Name) }</p>
					<p class="row"><button hx-post="dropbox/loved" hx-vals={ vals("service", b.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Make the album of loved photos") }</button></p>
					<h3>{ t(ctx, "Hand the photos on") }</h3>
					if len(b.OnwardOptions) == 0 {
						<p class="meta">{ t(ctx, "You do not send to any service yet. Join one on this page (under You can join) and you can hand this box's photos on to it, to a family member's library for instance.") }</p>
					} else {
						<form class="limits" hx-post="dropbox/onward" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
							<input type="hidden" name="service" value={ b.ID }/>
							<label>{ t(ctx, "Service") }
								<select name="target">
									<option value="" selected?={ b.OnwardService == "" }>{ t(ctx, "None") }</option>
									for _, o := range b.OnwardOptions {
										<option value={ o.Service } selected?={ b.OnwardService == o.Service }>{ onwardOptionLabel(ctx, o) }</option>
									}
								</select>
							</label>
							<label><input name="auto" type="checkbox" value="1" checked?={ b.OnwardAuto }/> { t(ctx, "Hand everything on by itself when the box closes") }</label>
							<button type="submit">{ t(ctx, "Save") }</button>
						</form>
						if b.OnwardService != "" {
							<p class="row">
								<button class="primary" hx-post="dropbox/handon" hx-vals={ scopeVals(b.ID, "all") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Hand every photo in this box on to {service} now?", "service", b.OnwardService) } data-confirm-title={ t(ctx, "Hand the photos on?") } data-confirm-label={ t(ctx, "Hand on") }>{ t(ctx, "Hand everything on now") }</button>
								if b.HasBest {
									<button hx-post="dropbox/handon" hx-vals={ scopeVals(b.ID, "best") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Hand the best-of on to {service} now?", "service", b.OnwardService) } data-confirm-title={ t(ctx, "Hand the photos on?") } data-confirm-label={ t(ctx, "Hand on") }>{ t(ctx, "Hand the best-of on now") }</button>
								}
							</p>
						}
						<small class="meta">{ t(ctx, "This tags the photos with the service's tag in your own library, which is what hands them over, so the service's limits, quiet hours, rules, expiry and taking back all apply. If you chose to keep your originals when you joined, they stay; if you chose to move them, they go to your trash after they are handed over.") }</small>
					}
					if len(b.OnwardLog) > 0 {
						<ul class="plain">
							for _, o := range b.OnwardLog {
								<li class="meta">{ o.When } · { t(ctx, "{n} photos ({what}) to {service}", "n", o.Count, "what", o.Scope, "service", o.Service) } · { o.By }</li>
							}
						</ul>
					}
				}
				if b.Owner && b.Files > 0 {
					<p class="row"><a class="button" href={ templ.SafeURL("dropbox/zip/" + b.ID) } download>{ t(ctx, "Download every photo as a ZIP") }</a></p>
					<small class="meta">{ t(ctx, "A ZIP of the originals of every photo this box kept, made while you download it, with your own sign-in. Large events take a while.") }</small>
				}
				if b.Owner {
					<details class="more">
						<summary>{ t(ctx, "Share the photos back with the guests") }</summary>
						if b.Share != nil {
							<div class="field">
								<label for={ "share-" + id }>{ t(ctx, "Link for guests to see and download the photos") }</label>
								<div class="row">
									<input id={ "share-" + id } class="invite" readonly data-share-key={ b.Share.Key } data-share-url={ b.Share.URL }/>
									<button type="button" class="copy">{ t(ctx, "Copy") }</button>
									<button type="button" class="copy-message" data-for={ "share-" + id } data-message={ t(ctx, "Thank you for being there! The photos are here: {link}", "link", "{link}") }>{ t(ctx, "Copy a message") }</button>
									<button type="button" class="show-qr" data-for={ "share-" + id } data-alt={ t(ctx, "QR code of the link to the photos") }>{ t(ctx, "QR code") }</button>
								</div>
								<div class="qr" id={ "qr-share-" + id } hidden></div>
								<p class="meta">{ t(ctx, "Open until {when}.", "when", b.Share.Expires) }</p>
							</div>
							<p class="row"><button class="danger" hx-post="dropbox/unshare" hx-vals={ vals("service", b.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The link stops working. The album and the photos stay in your library.") } data-confirm-title={ t(ctx, "Stop sharing?") } data-confirm-label={ t(ctx, "Stop sharing") } data-danger="true">{ t(ctx, "Stop sharing") }</button></p>
						}
						<form class="limits" hx-post="dropbox/share" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
							<input type="hidden" name="service" value={ b.ID }/>
							<label>{ t(ctx, "Open for (days)") } <input name="days" type="number" min="1" max="365" value="30" class="narrow"/></label>
							<label>{ t(ctx, "Password (optional)") } <input name="password" maxlength="64" autocomplete="off"/></label>
							<label>{ t(ctx, "Thank-you message (optional)") } <input name="message" maxlength="300"/></label>
							<button type="submit" class="primary">
								if b.Share != nil {
									{ t(ctx, "Share again with what came since") }
								} else {
									{ t(ctx, "Share the photos") }
								}
							</button>
							<small class="meta">{ t(ctx, "This puts what the box received into an album of yours (the box's album, or one named after the box) and makes a link to it in Immich that anyone who has it can open, with no account, to look at the photos and download them. It cannot upload or change anything. Use a password if the photos are private. Doing it again adds what came since and replaces the link.") }</small>
						</form>
					</details>
				}
				if b.PendingN > 0 {
					<h3>{ t(ctx, "Waiting for approval") } <span class="count-badge">{ fmt.Sprint(b.PendingN) }</span></h3>
					if b.Manage {
						<form class="pending" hx-post="dropbox/approve" hx-target="#flash" hx-swap="innerHTML">
							<input type="hidden" name="service" value={ b.ID }/>
							<ul class="plain thumbs">
								for _, p := range b.Pending {
									<li>
										if p.Image {
											<img src={ "dropbox/pending/" + p.ID } alt={ p.Name } loading="lazy" width="96" height="96"/>
										} else {
											<span class="thumb-video">{ t(ctx, "video") }</span>
										}
										<label><input type="checkbox" name="item" value={ p.ID }/> <span class="meta">{ p.Name } · { p.Size }</span></label>
									</li>
								}
							</ul>
							if b.PendingN > len(b.Pending) {
								<p class="meta">{ t(ctx, "Showing the first {n}; decide on these and the rest appear.", "n", len(b.Pending)) }</p>
							}
							<p class="row">
								<button class="primary" type="submit" data-act="approve">{ t(ctx, "Approve chosen") }</button>
								<button type="button" hx-post="dropbox/reject" hx-include="closest form" hx-target="#flash" hx-swap="innerHTML" data-act="reject">{ t(ctx, "Reject chosen") }</button>
								<button type="button" hx-post="dropbox/approve" hx-vals={ allVals(b.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" data-act="approve-all">{ t(ctx, "Approve all") }</button>
								<button type="button" hx-post="dropbox/reject" hx-vals={ allVals(b.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Reject every waiting file? They are deleted.") } data-confirm-title={ t(ctx, "Reject all?") } data-confirm-label={ t(ctx, "Reject all") } data-danger="true" data-act="reject-all">{ t(ctx, "Reject all") }</button>
							</p>
						</form>
					} else {
						<p class="meta">{ t(ctx, "Photos that wait for a host's approval are only shown to the people who decide.") }</p>
					}
				}
				if b.Owner {
					<h3>{ t(ctx, "Moderator link") }</h3>
					if b.ModToken != "" {
						<div class="field">
							<label for={ "mod-" + id }>{ t(ctx, "Link for a helper who looks at the files that wait (no account needed)") }</label>
							<div class="row">
								<input id={ "mod-" + id } class="invite" readonly data-link={ "mod/" + b.ModToken }/>
								<button type="button" class="copy">{ t(ctx, "Copy") }</button>
								<button type="button" class="show-qr" data-for={ "mod-" + id } data-alt={ t(ctx, "QR code of the moderator link") }>{ t(ctx, "QR code") }</button>
								<a class="button" href={ templ.SafeURL("mod/" + b.ModToken) } target="_blank" rel="noopener">{ t(ctx, "Open") }</a>
							</div>
							<div class="qr" id={ "qr-mod-" + id } hidden></div>
						</div>
						<p class="row">
							<button hx-post="dropbox/moderator" hx-vals={ vals2("service", b.ID, "on", "1") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The current moderator link stops working. Continue?") } data-confirm-title={ t(ctx, "Make a new moderator link?") } data-confirm-label={ t(ctx, "New moderator link") }>{ t(ctx, "New moderator link") }</button>
							<button class="danger" hx-post="dropbox/moderator" hx-vals={ vals2("service", b.ID, "on", "0") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The moderator link stops working at once.") } data-confirm-title={ t(ctx, "End the moderator link?") } data-confirm-label={ t(ctx, "End the link") } data-danger="true">{ t(ctx, "End the moderator link") }</button>
						</p>
					} else {
						<p class="meta">{ t(ctx, "A moderator link opens a page where someone with no account, a friend at the party for example, approves or rejects the files that wait for you. It shows nothing of your library and none of the box's settings, and cannot pause or end the box. Anyone who has the link can decide on the files, so share it with people you trust.") }</p>
						<p class="row"><button hx-post="dropbox/moderator" hx-vals={ vals2("service", b.ID, "on", "1") } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Make a moderator link") }</button></p>
					}
					<h3>{ t(ctx, "Co-hosts") }</h3>
					<p class="meta">{ t(ctx, "People on this Immich server who help you look after the box. They see it on their own page. They never see your library, and only you can end the box.") }</p>
					for _, h := range b.Hosts {
						<p class="row">
							<span class="chip">{ h.Name }</span>
							<span class="meta">{ h.Email } · { hostRoleLabel(ctx, h.Manage) }</span>
							<button hx-post="dropbox/host/remove" hx-vals={ hostVals(b.ID, h.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this">{ t(ctx, "Remove") }</button>
						</p>
					}
					<form class="limits" hx-post="dropbox/host" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
						<input type="hidden" name="service" value={ b.ID }/>
						<label>{ t(ctx, "Email of the person") } <input name="email" type="email" required maxlength="200"/></label>
						<label>{ t(ctx, "They may") }
							<select name="role">
								<option value="manage">{ t(ctx, "Approve, pause and extend") }</option>
								<option value="view">{ t(ctx, "Only look") }</option>
							</select>
						</label>
						<button type="submit">{ t(ctx, "Add co-host") }</button>
					</form>
				}
			}
			if len(b.Log) > 0 {
				<h3>{ t(ctx, "Log") }</h3>
				<ol class="timeline">
					for _, a := range b.Log {
						<li><time>{ a.When }</time><span class={ "dot", a.Tone } aria-hidden="true"></span><span>{ a.Text }</span></li>
					}
				</ol>
			}
			if b.Owner && b.State != "revoked" {
				<div class="danger-zone">
					<span class="meta">{ t(ctx, "Revoking ends the drop box for good: the link stops working at once and its key is deleted from your Immich account. Photos already received stay in your library.") }</span>
					<button class="danger" hx-post="dropbox/revoke" hx-vals={ vals("service", b.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "Revoke {name}? Its link stops working and nobody can send photos through it again.", "name", b.Name) } data-confirm-title={ t(ctx, "Revoke {name}?", "name", b.Name) } data-confirm-label={ t(ctx, "Revoke drop box") } data-danger="true">{ t(ctx, "Revoke drop box") }</button>
				</div>
			}
		</div>
	</details>
}

templ DropBoxForm() {
	<form class="card offer-form" hx-post="dropbox" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
		<p class="meta">{ t(ctx, "The app makes a key in your Immich account that can only add photos and tag them, nothing else. You can pause or revoke the box at any time.") }</p>
		<div class="form-grid">
			<div class="field">
				<label for="drop-name">{ t(ctx, "Name") }</label>
				<input id="drop-name" name="name" required minlength="2" maxlength="60" placeholder={ t(ctx, "Anna and Marco's wedding") }/>
			</div>
			<div class="field">
				<label for="drop-days">{ t(ctx, "Open for (days)") }</label>
				<input id="drop-days" name="opendays" type="number" min="1" max="365" value="14"/>
			</div>
			<div class="field">
				<label for="drop-opens">{ t(ctx, "Opens at (optional, otherwise now)") }</label>
				<input id="drop-opens" name="opens" type="datetime-local"/>
			</div>
			<div class="field">
				<label for="drop-closes">{ t(ctx, "Closes at (optional, replaces the days)") }</label>
				<input id="drop-closes" name="closes" type="datetime-local"/>
			</div>
			<div class="field wide">
				<label for="drop-message">{ t(ctx, "Message for guests (optional)") }</label>
				<input id="drop-message" name="message" maxlength="300" placeholder={ t(ctx, "Thank you for being there! Send us your photos.") }/>
			</div>
			<div class="field">
				<label for="drop-filemb">{ t(ctx, "Largest file (MB)") }</label>
				<input id="drop-filemb" name="filemb" type="number" min="0" max="1000000" value="500"/>
			</div>
			<div class="field">
				<label for="drop-mb">{ t(ctx, "Most megabytes in all") }</label>
				<input id="drop-mb" name="mb" type="number" min="0" max="1000000" value="20000"/>
			</div>
			<div class="field">
				<label for="drop-files">{ t(ctx, "Most files in all") }</label>
				<input id="drop-files" name="files" type="number" min="0" max="1000000" value="2000"/>
			</div>
			<div class="field">
				<label for="drop-keep">{ t(ctx, "Keep what guests leave for (days after it ends)") }</label>
				<input id="drop-keep" name="keepdays" type="number" min="0" max="3650" value="30"/>
			</div>
			<div class="field">
				<label for="drop-secure">{ t(ctx, "Secure with a password...") }</label>
				<select id="drop-secure" name="secure">
					<option value="none" selected>{ t(ctx, "No") }</option>
					<option value="upload">{ t(ctx, "Upload") }</option>
					<option value="page">{ t(ctx, "The whole page") }</option>
				</select>
			</div>
			<div class="field" data-secure-password>
				<label for="drop-pass">{ t(ctx, "Password") }</label>
				<input id="drop-pass" name="password" type="text" maxlength="64" autocomplete="off"/>
			</div>
			<small class="meta wide">{ t(ctx, "Upload: anyone with the link can see the page, and needs the password to send. The whole page: nothing is shown, and nothing can be sent, without the password. A wall you start has its own link and is not covered.") }</small>
			<div class="field">
				<label for="drop-album">{ t(ctx, "Put what arrives in this album (optional)") }</label>
				<input id="drop-album" name="album" maxlength="100"/>
			</div>
			<div class="field">
				<label for="drop-tag">{ t(ctx, "Another tag for what arrives (optional)") }</label>
				<input id="drop-tag" name="tag" maxlength="100"/>
			</div>
			<label class="wide"><input name="photos" type="checkbox" value="1"/> { t(ctx, "Photos only (no videos)") }</label>
			<label class="wide"><input name="approve" type="checkbox" value="1"/> { t(ctx, "I look at every file before it is kept") }</label>
			<div class="field wide">
				<label for="drop-prompts">{ t(ctx, "Shot list (optional, one per line, at most 20)") }</label>
				<textarea id="drop-prompts" name="prompts" rows="3" placeholder={ t(ctx, "The first dance\nThe oldest guest\nThe best hat") }></textarea>
			</div>
			<label class="wide"><input name="required" type="checkbox" value="1"/> { t(ctx, "Every photo must say which one it is for") }</label>
			<label class="wide"><input name="guestbook" type="checkbox" value="1"/> { t(ctx, "Message to the host: guests may leave a message, with their name, and a voice note") }</label>
			<label class="wide"><input name="gallery" type="checkbox" value="1"/> { t(ctx, "Guests may look at the photos and heart them") }</label>
			<label class="wide"><input name="gallerydownload" type="checkbox" value="1"/> { t(ctx, "and download them") }</label>
			<label class="wide"><input name="gallerynames" type="checkbox" value="1"/> { t(ctx, "and see who sent each photo (the page asks guests for a name)") }</label>
			<small class="meta wide">{ t(ctx, "Every guest with the link then sees every photo the box has kept, not only their own. Photos waiting for your approval are never shown. The box's key gets permission to view pictures, and to download if you allow it.") }</small>
			<label class="wide"><input name="guestdelete" type="checkbox" value="1"/> { t(ctx, "Guests may take back what they sent, while it is still in the inbox") }</label>
			<small class="meta wide">{ t(ctx, "For that the box's key also gets permission to read photos and move them to your trash (never to delete them for good). Guests keep a secret in their browser, so only they can take back their own files.") }</small>
			<small class="meta wide">{ t(ctx, "An album gives the key permission to find, make and add to albums, nothing more. Files that wait for you are kept on this server's disk until you decide, and deleted after two weeks.") }</small>
			<small class="meta wide">{ t(ctx, "0 means no limit. The link stops working by itself after the days you choose. A box pauses by itself if it is flooded with files or with refusals.") }</small>
		</div>
		<p class="row form-actions"><button class="primary" type="submit">{ t(ctx, "Make drop box") }</button></p>
	</form>
}

// DropPage is what a guest opens: a name, a message and a way to send photos. Nothing in it comes from the library.
templ DropPage(d DropPageView) {
	@Layout(d.Name, "") {
		if d.Cover {
			<img class="drop-cover" src={ "drop/" + d.Token + "/cover" } alt="" width="640" height="240"/>
		}
		<section class="invite-hero">
			if d.Logo {
				<img class="drop-logo" src={ "drop/" + d.Token + "/logo" } alt={ d.Name } height="64"/>
			}
			<h1>{ d.Name }</h1>
			if d.Message != "" {
				<p class="lead">{ d.Message }</p>
			} else {
				<p class="lead">{ t(ctx, "Send your photos here. No account is needed.") }</p>
			}
		</section>
		<form class="card offer-form drop-form" method="post" enctype="multipart/form-data" action={ "drop/" + d.Token + "/upload" } data-maxdim={ fmt.Sprint(d.MaxDim) } data-key={ d.Token }>
			if d.Password {
				<div class="field">
					<label for="drop-pw">{ t(ctx, "Password") }</label>
					<input id="drop-pw" name="password" type="password" required autocomplete="off"/>
				</div>
			}
			if len(d.Prompts) > 0 {
				<div class="field">
					<label for="drop-prompt">{ t(ctx, "What is the photo for?") }</label>
					<select id="drop-prompt" name="prompt" required?={ d.PromptRequired }>
						if d.PromptRequired {
							<option value="">{ t(ctx, "Choose one") }</option>
						} else {
							<option value="">{ t(ctx, "Anything") }</option>
						}
						for _, p := range d.Prompts {
							<option value={ p.ID }>{ p.Text }</option>
						}
					</select>
				</div>
				<ul class="plain checklist">
					for _, p := range d.Prompts {
						<li><span class={ "chip", templ.KV("ok", p.Files > 0) }>{ promptState(ctx, p.Files) }</span> { p.Text }</li>
					}
				</ul>
			}
			if d.GalleryNames {
				<div class="field">
					<label for="drop-guest">{ t(ctx, "Your name (shown with your photos)") }</label>
					<input id="drop-guest" name="guest" maxlength="40" autocomplete="name" data-remember="guest"/>
				</div>
			}
			<div class="dz" data-photos-only?={ d.PhotosOnly }>
				<svg class="dz-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 33h-1a8 8 0 0 1-1.2-15.9A12 12 0 0 1 35 14.5 9.5 9.5 0 0 1 35 33h-1"></path><path d="M24 40V23"></path><path d="m18 28 6-6 6 6"></path></svg>
				<label class="dz-title" for="drop-files">{ dropChoose(ctx, d.PhotosOnly) }</label>
				<small class="meta dz-hint">{ t(ctx, "You can also drop files here.") }</small>
				<input id="drop-files" class="dz-input" name="files" type="file" multiple required accept={ dropAccept(d.PhotosOnly) }/>
			</div>
			<div class="field camera-only">
				<label for="drop-camera">{ t(ctx, "Or take a photo now") }</label>
				<input id="drop-camera" name="camera" type="file" accept="image/*" capture="environment"/>
			</div>
			<div class="drop-summary" hidden>
				<span class="drop-count" aria-live="polite"></span>
				<button type="button" class="link drop-clear">{ t(ctx, "Remove all") }</button>
			</div>
			<ul class="plain drop-list" aria-live="polite" hidden></ul>
			<div class="drop-result" role="status" aria-live="polite" hidden></div>
			<p class="meta">{ d.Limits }</p>
			if d.Gallery {
				<p class="meta">{ t(ctx, "Everyone who has this link can see the photos that were kept, below.") }</p>
			} else {
				<p class="meta">{ t(ctx, "Only the person who made this link can see what you send. You will not see anyone else's photos.") }</p>
			}
			if d.Approve {
				<p class="meta">{ t(ctx, "What you send is looked at before it is kept.") }</p>
			}
			if d.CanDelete {
				<p class="meta">{ t(ctx, "You can take back what you sent from") } <a href={ templ.SafeURL("drop/" + d.Token + "/mine") }>{ t(ctx, "your uploads") }</a>.</p>
			}
			<p class="row form-actions"><button class="primary drop-send" type="submit" data-label={ t(ctx, "Send") }>{ t(ctx, "Send") }</button></p>
		</form>
		if d.Gallery {
			@Gallery(d.Token, d.GalleryDownload)
		}
		if d.GuestBook {
			<form class="card offer-form guestbook-form" method="post" enctype="multipart/form-data" action={ "drop/" + d.Token + "/message" }>
				<h2>{ t(ctx, "Message to the host") }</h2>
				<div class="field">
					<label for="gb-name">{ t(ctx, "Your name") }</label>
					<input id="gb-name" name="name" required maxlength="60" autocomplete="name"/>
				</div>
				<div class="field">
					<label for="gb-text">{ t(ctx, "Your message") }</label>
					<textarea id="gb-text" name="text" rows="3" maxlength="1000"></textarea>
				</div>
				<div class="field voice-tools" hidden>
					<button type="button" class="voice-record">{ t(ctx, "Record a voice message") }</button>
					<audio class="voice-preview" controls hidden></audio>
				</div>
				<p class="meta">{ t(ctx, "Only the person who made this link and the people who help them can read or hear it.") }</p>
				<p class="row form-actions"><button class="primary" type="submit">{ t(ctx, "Send the message") }</button></p>
				<p class="meta guestbook-status" role="status" aria-live="polite"></p>
			</form>
		}
	}
}

// Gallery is the photos a box has kept, as a guest sees them: a grid that fills in by itself (ts/gallery.ts), a heart on
// each and, when the box allows, a way to download the original.
templ Gallery(token string, download bool) {
	<section class="gallery" data-gallery data-feed={ "drop/" + token + "/gallery" } data-photo={ "drop/" + token + "/photo/" } data-original={ "drop/" + token + "/original/" } data-heart={ "drop/" + token + "/heart/" } data-download?={ download } data-love={ t(ctx, "Heart") } data-unlove={ t(ctx, "Take the heart back") } data-save={ t(ctx, "Download") } data-by={ t(ctx, "by {name}") } data-open={ t(ctx, "Look at the photo") } data-close={ t(ctx, "Close") }>
		<h2>{ t(ctx, "The photos so far") }</h2>
		if download {
			<p class="row gallery-zip"><a class="button" href={ templ.SafeURL("drop/" + token + "/zip") } download>{ t(ctx, "Download all as a ZIP") }</a> <small class="meta">{ t(ctx, "The originals of all the photos, made while you download, so it can take a while.") }</small></p>
		}
		<p class="meta gallery-empty">{ t(ctx, "No photos yet. They appear here by themselves as they are kept.") }</p>
		<ul class="plain gal" aria-live="polite"></ul>
		<p class="row"><button type="button" class="gallery-more" hidden>{ t(ctx, "Show more") }</button></p>
	</section>
}

// DropAlbum is what a guest opens after the box has closed, for as long as what guests left with it is kept: the photos,
// to look at and heart (and download, if the box allows), and the owner's thanks. Nothing can be sent any more.
templ DropAlbum(d DropPageView, share *ShareView) {
	@Layout(d.Name, "") {
		if d.Cover {
			<img class="drop-cover" src={ "drop/" + d.Token + "/cover" } alt="" width="640" height="240"/>
		}
		<section class="invite-hero">
			if d.Logo {
				<img class="drop-logo" src={ "drop/" + d.Token + "/logo" } alt={ d.Name } height="64"/>
			}
			<h1>{ d.Name }</h1>
			<p class="lead">{ t(ctx, "This event is over. Thank you for being part of it!") }</p>
		</section>
		if share != nil {
			<p class="row">
				<a class="button primary share-link" data-share-key={ share.Key } data-share-url={ share.URL } href={ templ.SafeURL(shareHref(*share)) }>{ t(ctx, "See all the photos") }</a>
			</p>
			if share.Expires != "" {
				<p class="meta">{ t(ctx, "Open until {when}.", "when", share.Expires) }</p>
			}
		}
		@Gallery(d.Token, d.GalleryDownload)
	}
}

// ModPage is the moderator's page: the files that wait, to approve or reject.
templ ModPage(d ModPageView) {
	@Layout(d.Name, "") {
		<section class="invite-hero">
			<h1>{ d.Name }</h1>
			<p class="lead">{ t(ctx, "You are helping to look after this box. Approve the photos that may stay, reject the others.") }</p>
		</section>
		if d.Message != "" {
			<p class="card mod-message" role="status">{ d.Message }</p>
		}
		if d.Total == 0 {
			<p class="meta">{ t(ctx, "Nothing is waiting. This page does not refresh by itself: reload it to look again.") }</p>
		} else {
			<form class="card pending mod-form" method="post" action={ "mod/" + d.Token + "/approve" }>
				<h2>{ t(ctx, "Waiting for approval") } <span class="count-badge">{ fmt.Sprint(d.Total) }</span></h2>
				<ul class="plain thumbs">
					for _, p := range d.Items {
						<li>
							if p.Image {
								<img src={ "mod/" + d.Token + "/pending/" + p.ID } alt={ p.Name } loading="lazy" width="96" height="96"/>
							} else {
								<span class="thumb-video">{ t(ctx, "video") }</span>
							}
							<label><input type="checkbox" name="item" value={ p.ID }/> <span class="meta">{ p.Name } · { p.Size }</span></label>
						</li>
					}
				</ul>
				if d.Total > len(d.Items) {
					<p class="meta">{ t(ctx, "Showing the first {n}; decide on these and the rest appear.", "n", len(d.Items)) }</p>
				}
				<p class="row">
					<button type="button" class="select-all" hidden>{ t(ctx, "Choose all") }</button>
					<button class="primary" type="submit">{ t(ctx, "Approve chosen") }</button>
					<button type="submit" formaction={ "mod/" + d.Token + "/reject" } data-act="reject">{ t(ctx, "Reject chosen") }</button>
				</p>
				<p class="row">
					<button type="submit" name="all" value="1">{ t(ctx, "Approve all") }</button>
				</p>
			</form>
		}
		if d.Looks {
			<section class="mod-photos" id="photos">
				<h2>{ t(ctx, "The photos kept") }</h2>
				<p class="meta">{ t(ctx, "Pin a photo so it is always in the best-of. Hide one and guests no longer see it (the gallery, the wall and the ZIP); it stays in the owner's library.") }</p>
				if len(d.Photos) == 0 {
					<p class="meta">{ t(ctx, "No photo has been kept yet.") }</p>
				}
				<ul class="plain mod-grid">
					for _, p := range d.Photos {
						<li id={ "photo-" + p.ID } class={ "mod-photo", templ.KV("is-hidden", p.Hidden), templ.KV("is-pinned", p.Pinned) }>
							<img src={ "mod/" + d.Token + "/photo/" + p.ID } alt="" loading="lazy" width="160" height="160"/>
							<span class="meta">
								if p.Hearts > 0 {
									{ fmt.Sprint(p.Hearts) } ♥
								}
								if p.By != "" {
									{ p.By }
								}
							</span>
							<form class="mod-mark" method="post" action={ "mod/" + d.Token + "/mark" }>
								<input type="hidden" name="item" value={ p.ID }/>
								if p.Pinned {
									<button type="submit" name="do" value="unpin" aria-pressed="true">{ t(ctx, "Pinned") }</button>
								} else {
									<button type="submit" name="do" value="pin" aria-pressed="false">{ t(ctx, "Pin") }</button>
								}
								if p.Hidden {
									<button type="submit" name="do" value="show" aria-pressed="true">{ t(ctx, "Hidden") }</button>
								} else {
									<button type="submit" name="do" value="hide" aria-pressed="false">{ t(ctx, "Hide") }</button>
								}
							</form>
						</li>
					}
				</ul>
				if d.More != "" {
					<p class="row"><a class="button" href={ templ.SafeURL("mod/" + d.Token + "?before=" + d.More + "#photos") }>{ t(ctx, "Older photos") }</a></p>
				}
			</section>
		}
	}
}

// DropLocked is all a guest sees of a box whose password guards the whole page, until they give it.
templ DropLocked(token string, wrong bool) {
	@Layout(t(ctx, "Password needed"), "") {
		<section class="invite-hero">
			<h1>{ t(ctx, "This page needs a password") }</h1>
			<p class="lead">{ t(ctx, "Ask the person who sent you the link for the password.") }</p>
		</section>
		<form class="card offer-form" method="post" action={ "drop/" + token + "/unlock" }>
			if wrong {
				<p class="meta bad-note" role="alert">{ t(ctx, "The password is not right. Try again.") }</p>
			}
			<div class="field">
				<label for="unlock-pw">{ t(ctx, "Password") }</label>
				<input id="unlock-pw" name="password" type="password" required autofocus autocomplete="off"/>
			</div>
			<p class="row form-actions"><button class="primary" type="submit">{ t(ctx, "Open") }</button></p>
		</form>
	}
}

// DropMessageDone thanks a guest whose message was kept, on a page with no script.
templ DropMessageDone(name, back string) {
	@Layout(name, "") {
		<section class="invite-hero">
			<h1>{ t(ctx, "Thank you for your message!") }</h1>
		</section>
		<p class="meta"><a href={ templ.SafeURL(back) }>{ t(ctx, "Send photos") }</a></p>
	}
}

// DropThanks is what the link of a box that has closed shows when its owner has shared the photos back.
templ DropThanks(name, message string, share ShareView) {
	@Layout(name, "") {
		<section class="invite-hero">
			<h1>{ t(ctx, "Thank you!") }</h1>
			if message != "" {
				<p class="lead">{ message }</p>
			} else {
				<p class="lead">{ t(ctx, "The photos from {name} are ready to see and download.", "name", name) }</p>
			}
		</section>
		<p class="row">
			<a class="button primary share-link" data-share-key={ share.Key } data-share-url={ share.URL } href={ templ.SafeURL(shareHref(share)) }>{ t(ctx, "See the photos") }</a>
		</p>
		if share.Expires != "" {
			<p class="meta">{ t(ctx, "Open until {when}.", "when", share.Expires) }</p>
		}
	}
}

// DropDone tells a guest what became of what they sent.
templ DropDone(name, back string, canDelete bool, lines []DropResultLine) {
	@Layout(name, "") {
		<section class="invite-hero">
			<h1>{ t(ctx, "Thank you!") }</h1>
			<p class="lead">{ dropSummary(ctx, lines) }</p>
		</section>
		<div class="card">
			<ul class="plain">
				for _, l := range lines {
					<li><span class={ "chip", templ.KV("ok", l.OK), templ.KV("bad", !l.OK) }>{ l.Text }</span> { l.Name }</li>
				}
			</ul>
		</div>
		<p class="meta">
			<a href={ templ.SafeURL(back) }>{ t(ctx, "Send more photos") }</a>
			if canDelete {
				· <a href={ templ.SafeURL(back + "/mine") }>{ t(ctx, "Your uploads") }</a>
			}
		</p>
	}
}

// DropMine is a guest's own uploads, each with a way to take it back.
templ DropMine(name, token string, files []GuestFileView, msg string) {
	@Layout(name, "") {
		<section class="invite-hero">
			<h1>{ t(ctx, "Your uploads") }</h1>
			<p class="lead">{ t(ctx, "What you sent to {name}. You can take a photo back while the owner has not filed it in their library.", "name", name) }</p>
		</section>
		if m := guestMessage(ctx, msg); m != "" {
			<p class="card">{ m }</p>
		}
		<div class="card">
			if len(files) == 0 {
				<p class="meta">{ t(ctx, "Nothing here yet from this browser.") }</p>
			}
			<ul class="plain">
				for _, f := range files {
					<li>
						<span class="meta">{ f.Name } · { f.Size }</span>
						if f.Waiting {
							<span class="chip warn">{ t(ctx, "waiting for approval") }</span>
						}
						<form method="post" action={ "drop/" + token + "/mine/delete" } class="inline">
							<input type="hidden" name="id" value={ f.ID }/>
							<button type="submit">{ t(ctx, "Take back") }</button>
						</form>
					</li>
				}
			</ul>
		</div>
		<p class="meta"><a href={ templ.SafeURL("drop/" + token) }>{ t(ctx, "Send more photos") }</a></p>
	}
}

// DropCard is a page to print for a table or a poster: the box's name, its message and a QR code of its link.
templ DropCard(user, name, message, link, mailAddress string) {
	@Layout(name, user) {
		<section class="card-sheet" data-card-link={ link }>
			<h1>{ name }</h1>
			if message != "" {
				<p class="lead">{ message }</p>
			}
			<div class="card-qr" id="card-qr"></div>
			<p class="card-url" id="card-url"></p>
			if mailAddress != "" {
				<p class="card-url">{ t(ctx, "Or send photos by email to {address}", "address", mailAddress) }</p>
			}
			<p class="no-print"><button type="button" id="card-print" class="primary">{ t(ctx, "Print") }</button></p>
		</section>
	}
}

// WallControls are the buttons that appear when the pointer moves on a wall or a frame and fade again: how photos are
// laid out (the wall only), how one gives way to the next, what is behind them, and full screen.
templ WallControls(modes bool, mode string) {
	<nav class="wall-controls" aria-label={ t(ctx, "Wall controls") }>
		if modes {
			<div class="grp" role="group" aria-label={ t(ctx, "Single photo") + ", " + t(ctx, "Collage") + ", " + t(ctx, "Grid") }>
				<button type="button" data-mode="single" aria-pressed={ checked(mode == "single") }>{ t(ctx, "Single photo") }</button>
				<button type="button" data-mode="collage" aria-pressed={ checked(mode == "collage") }>{ t(ctx, "Collage") }</button>
				<button type="button" data-mode="grid" aria-pressed={ checked(mode == "grid") }>{ t(ctx, "Grid") }</button>
			</div>
		}
		<div class="grp" role="group" aria-label={ t(ctx, "Transition") }>
			<button type="button" data-fx="fade" aria-pressed="true">{ t(ctx, "Fade") }</button>
			<button type="button" data-fx="zoom" aria-pressed="false">{ t(ctx, "Zoom") }</button>
			<button type="button" data-fx="slide" aria-pressed="false">{ t(ctx, "Slide") }</button>
			<button type="button" data-fx="rise" aria-pressed="false">{ t(ctx, "Rise") }</button>
		</div>
		<div class="grp" role="group" aria-label={ t(ctx, "Backdrop") }>
			<button type="button" data-bg="glow" aria-pressed="true">{ t(ctx, "Glow") }</button>
			<button type="button" data-bg="black" aria-pressed="false">{ t(ctx, "Black") }</button>
		</div>
		<button type="button" class="wall-full">{ t(ctx, "Full screen") }</button>
	</nav>
}

// WallPage is the slideshow a screen opens: no sign-in, no bar, only the photos and a few controls that fade away.
templ WallPage(name, token, mode string, logo bool) {
	<!DOCTYPE html>
	<html lang={ loc(ctx).Code() } { htmlTheme(ctx)... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			if b := baseHref(ctx); b != "" {
				<base href={ b }/>
			}
			<title>{ name }</title>
			<link rel="icon" href="static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="static/app.css"/>
			@templ.JSONScript("i18n", clientCatalog(ctx))
			<script src="static/app.js" defer></script>
		</head>
		<body class="wall">
			<main id="wall" data-feed={ "wall/" + token + "/feed" } data-photo={ "wall/" + token + "/photo/" } data-mode={ mode }>
				<div class="wall-stage" aria-live="polite"></div>
				<p class="wall-wait">{ t(ctx, "Waiting for the first photo") }</p>
				<div class="wall-note" hidden></div>
				if logo {
					<img class="wall-logo" src={ "wall/" + token + "/logo" } alt=""/>
				}
				@WallControls(true, mode)
			</main>
		</body>
	</html>
}

// FrameSection is where a person makes frames: links that show one of their albums on a screen with no account.
templ FrameSection(frames []FrameView) {
	<h2>{ t(ctx, "Frames") }</h2>
	<p class="meta">{ t(ctx, "A frame is a link that shows one of your albums full screen, on a photo frame, an old tablet or a TV, with no account on it. New photos in the album appear within a couple of minutes, and photos you take out disappear. The link is as private as its length: anyone who has it can see the album's photos, so end it when you no longer want that.") }</p>
	for i, f := range frames {
		@FrameRow(f, fmt.Sprintf("frame-%d", i), len(frames) == 1)
	}
	<details class="offer">
		<summary>{ t(ctx, "Make a frame") }</summary>
		<form class="card offer-form" hx-post="frames" hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="find button">
			<div class="field">
				<label for="fr-name">{ t(ctx, "Name") }</label>
				<input id="fr-name" name="name" required maxlength="60" placeholder={ t(ctx, "Living room") }/>
			</div>
			<div class="field" hx-get="fragments/frame-albums" hx-trigger="toggle from:closest details once" hx-swap="innerHTML">
				<p class="meta">{ t(ctx, "Loading your albums...") }</p>
			</div>
			<div class="field">
				<label for="fr-hold">{ t(ctx, "Show each photo for") }</label>
				<select id="fr-hold" name="hold">
					<option value="8">{ t(ctx, "{n} seconds", "n", 8) }</option>
					<option value="15" selected>{ t(ctx, "{n} seconds", "n", 15) }</option>
					<option value="30">{ t(ctx, "{n} seconds", "n", 30) }</option>
					<option value="60">{ t(ctx, "{n} seconds", "n", 60) }</option>
				</select>
			</div>
			<div class="field">
				<label for="fr-ends">{ t(ctx, "The link works") }</label>
				<select id="fr-ends" name="ends">
					<option value="0" selected>{ t(ctx, "until I end it") }</option>
					<option value="30">{ t(ctx, "for 30 days") }</option>
					<option value="90">{ t(ctx, "for 90 days") }</option>
					<option value="365">{ t(ctx, "for a year") }</option>
				</select>
			</div>
			<p class="meta">{ t(ctx, "This makes a key in your Immich account that can only look at pictures and list an album's photos. It is deleted when you end the frame.") }</p>
			<p class="row form-actions"><button class="primary" type="submit">{ t(ctx, "Make frame") }</button></p>
		</form>
	</details>
}

// FrameAlbumSelect is the list of albums in the form that makes a frame.
templ FrameAlbumSelect(albums []AlbumOption) {
	if len(albums) == 0 {
		<p class="meta">{ t(ctx, "You have no albums of your own yet. Make one in Immich, then come back.") }</p>
	} else {
		<label for="fr-album">{ t(ctx, "Album to show") }</label>
		<select id="fr-album" name="album">
			for _, a := range albums {
				<option value={ a.ID }>{ a.Label }</option>
			}
		</select>
	}
}

// FrameRow is one frame: its link, when it ends, and a button to end it.
templ FrameRow(f FrameView, id string, open bool) {
	<details class="svc card" name="svc" open?={ open }>
		@RowHead(f.Name, t(ctx, "frame of {album}", "album", f.Album), frameChips(ctx, f), "sum-"+id)
		<div class="body">
			if f.Ended {
				<p class="meta"><span class="chip bad">{ t(ctx, "Ended") }</span> { t(ctx, "This frame's link stopped on {when}. Remove it to delete its key from your Immich account.", "when", f.Ends) }</p>
			} else {
				<div class="field">
					<label for={ "fr-link-" + id }>{ t(ctx, "Link to open on the screen") }</label>
					<div class="row">
						<input id={ "fr-link-" + id } class="invite" readonly data-link={ "frame/" + f.Token }/>
						<button type="button" class="copy">{ t(ctx, "Copy") }</button>
						<button type="button" class="show-qr" data-for={ "fr-link-" + id } data-alt={ t(ctx, "QR code of the frame's link") }>{ t(ctx, "QR code") }</button>
					</div>
					<div class="qr" id={ "qr-fr-link-" + id } hidden></div>
				</div>
				<p class="meta">{ t(ctx, "Shows each photo for {n} seconds.", "n", f.Seconds) }
					if f.Ends != "" {
						{ t(ctx, "The link works until {when}.", "when", f.Ends) }
					} else {
						{ t(ctx, "The link works until you end it.") }
					}
				</p>
			}
			<p class="row"><button hx-post="frames/end" hx-vals={ vals("frame", f.ID) } hx-target="#flash" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm={ t(ctx, "The link will stop working at once and the frame's key will be deleted. Continue?") } data-confirm-title={ t(ctx, "End the frame?") } data-confirm-label={ t(ctx, "End frame") } data-danger="true">
				if f.Ended {
					{ t(ctx, "Remove") }
				} else {
					{ t(ctx, "End frame") }
				}
			</button></p>
		</div>
	</details>
}

// FramePage is the page a frame opens: full screen, no sign-in, no controls.
templ FramePage(name, token string, seconds int) {
	<!DOCTYPE html>
	<html lang={ loc(ctx).Code() } { htmlTheme(ctx)... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="robots" content="noindex"/>
			if b := baseHref(ctx); b != "" {
				<base href={ b }/>
			}
			<title>{ name }</title>
			<link rel="icon" href="static/favicon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="static/app.css"/>
			@templ.JSONScript("i18n", clientCatalog(ctx))
			<script src="static/app.js" defer></script>
		</head>
		<body class="wall">
			<main id="frame" data-feed={ "frame/" + token + "/feed" } data-photo={ "frame/" + token + "/photo/" } data-seconds={ fmt.Sprint(seconds) }>
				<div class="wall-stage single" aria-live="off"></div>
				<p class="wall-wait">{ t(ctx, "Waiting for the first photo") }</p>
				@WallControls(false, "")
			</main>
		</body>
	</html>
}

// BridgePageView is the page where someone on another Immich server connects.
type BridgePageView struct {
	Token, Service, Owner string
	Permissions           []string
	Error                 string // why the last attempt did not work
	Address, Name         string // what they typed, so a mistake can be corrected
	Done                  bool
}

// BridgePage is where the person invited from another Immich server makes a key and connects. It is a guest page: no
// account, nothing about any library.
templ BridgePage(d BridgePageView) {
	@Layout(d.Service, "") {
		if d.Done {
			<section class="invite-hero">
				<h1>{ t(ctx, "Connected") }</h1>
				<p class="lead">{ t(ctx, "{service} will now send photos to your Immich. You can close this page.", "service", d.Service) }</p>
			</section>
		} else {
			<section class="invite-hero">
				<h1>{ t(ctx, "Receive {service} in your own Immich", "service", d.Service) }</h1>
				<p class="lead">{ t(ctx, "{owner} would like to hand photos over to you, straight into your own Immich. Nothing happens until you make a key and enter it here.", "owner", d.Owner) }</p>
			</section>
			if d.Error != "" {
				<p class="card notice bad" role="alert">{ t(ctx, "That did not work:") } { d.Error }</p>
			}
			<div class="card">
				<h2>{ t(ctx, "1. Make a key in your Immich") }</h2>
				<p>{ t(ctx, "In your Immich, open Account settings, API keys, New API key. Give it exactly these permissions and no others:") }</p>
				<ul class="plain">
					for _, p := range d.Permissions {
						<li><code>{ p }</code></li>
					}
				</ul>
				<p class="meta">{ t(ctx, "The key can upload photos and put a tag on them. It cannot see, search or download anything in your library, and it cannot delete anything unless you add the optional permission below.") }</p>
				<p class="meta">{ t(ctx, "Optional: add {permission} if you want {owner} to be able to take a hand-over back within 24 hours. The app then moves the photos it handed over to your trash (it never deletes them for good, and still cannot see or search your library). It cannot tell whether you have already filed one in an album, so that one goes to the trash too.", "permission", "asset.delete", "owner", d.Owner) }</p>
			</div>
			<form class="card offer-form" method="post" action={ "bridge/" + d.Token }>
				<h2>{ t(ctx, "2. Enter it here") }</h2>
				<div class="field">
					<label for="br-address">{ t(ctx, "Address of your Immich") }</label>
					<input id="br-address" name="address" required inputmode="url" autocomplete="off" placeholder="https://photos.example.org" value={ d.Address }/>
				</div>
				<div class="field">
					<label for="br-key">{ t(ctx, "The key") }</label>
					<input id="br-key" name="key" type="password" required autocomplete="off"/>
				</div>
				<div class="field">
					<label for="br-name">{ t(ctx, "Your name, as {owner} will see it", "owner", d.Owner) }</label>
					<input id="br-name" name="name" required maxlength="40" autocomplete="name" value={ d.Name }/>
				</div>
				<p class="row form-actions"><button class="primary" type="submit">{ t(ctx, "Connect") }</button></p>
			</form>
			<div class="card">
				<h2>{ t(ctx, "Good to know") }</h2>
				<ul class="plain">
					<li>{ t(ctx, "Photos arrive in your library with a tag that says who they are from, inside the tag \"from\".") }</li>
					<li>{ t(ctx, "Letting copies expire does not work across servers. Taking a hand-over back works only if you add the optional permission. What arrives is yours to keep or remove.") }</li>
					<li>{ t(ctx, "You can cut the connection at any time by deleting the key in your Immich. Photos not yet sent stay with {owner}; nothing is lost.", "owner", d.Owner) }</li>
				</ul>
			</div>
		}
	}
}

func bridgeTone(state string) string {
	switch state {
	case "ok":
		return "ok"
	case "unreachable":
		return "warn"
	}
	return "bad"
}

func bridgeStateLabel(state string) string {
	switch state {
	case "ok":
		return "Connected"
	case "unreachable":
		return "Cannot be reached"
	}
	return "Key revoked"
}

// SendPageView is the page for sending photos from this device.
type SendPageView struct {
	User, ID  string
	On        bool // the server has a data folder to keep the pieces in
	Targets   []SendTarget
	FileMB    int
	WaitMB    int
	KeepHours int
}

// SendTarget is a service the person sends to.
type SendTarget struct{ Name, Hold string }

// SendPage is "Send photos": pick photos and videos, pick where they go, and watch them leave (ts/send.ts).
templ SendPage(d SendPageView) {
	@Layout(t(ctx, "Send photos"), d.User) {
		<p id="flash" class="toast" role="status" aria-live="polite"></p>
		<h1>
			@templ.Raw(h(ctx, "Send <em>photos</em> from this device"))
		</h1>
		<p class="lead">{ t(ctx, "Photos and videos go to your own Immich exactly as they are, and then to the service you choose.") } <a href="./">{ t(ctx, "Back to your own page") }</a></p>
		if !d.On {
			<section class="card notice">
				<header><span class="chip warn">{ t(ctx, "Not switched on") }</span></header>
				<p class="meta">{ t(ctx, "Sending photos from a phone needs the app's data folder, which this install does not have. Ask whoever runs it.") }</p>
			</section>
		} else {
			<section class="card notice" id="send-install" hidden>
				<h3>{ t(ctx, "Share photos to Handoff from your gallery") }</h3>
				<p class="meta">{ t(ctx, "Install Handoff on this phone and it appears in the Share menu of your gallery: choose photos, tap Share, then Handoff, and pick where they go.") }</p>
				<p class="row"><button type="button" class="primary" id="send-install-go">{ t(ctx, "Install Handoff") }</button></p>
			</section>
			<form class="card send-form" id="send" data-file-mb={ fmt.Sprint(d.FileMB) } data-wait-mb={ fmt.Sprint(d.WaitMB) } data-keep-hours={ fmt.Sprint(d.KeepHours) } data-user={ d.ID }>
				<div class="dz">
					<svg class="dz-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 33h-1a8 8 0 0 1-1.2-15.9A12 12 0 0 1 35 14.5 9.5 9.5 0 0 1 35 33h-1"></path><path d="M24 40V23"></path><path d="m18 28 6-6 6 6"></path></svg>
					<label class="dz-title" for="send-files">{ t(ctx, "Choose photos and videos") }</label>
					<small class="meta dz-hint">{ t(ctx, "From this device's gallery or files.") }</small>
					<input id="send-files" class="dz-input" type="file" multiple accept="image/*,video/*,.heic,.heif,.dng"/>
				</div>
				<fieldset class="targets">
					<legend>{ t(ctx, "Where should they go?") }</legend>
					for i, tg := range d.Targets {
						<label class="target">
							<input type="radio" name="service" value={ tg.Name } checked?={ i == 0 }/>
							<span><b>{ tg.Name }</b>
								if tg.Hold != "" {
									<small class="meta">{ tg.Hold }</small>
								}
							</span>
						</label>
					}
					<label class="target">
						<input type="radio" name="service" value="" checked?={ len(d.Targets) == 0 }/>
						<span><b>{ t(ctx, "My library only") }</b><small class="meta">{ t(ctx, "Keep them in your Immich; hand nothing over.") }</small></span>
					</label>
				</fieldset>
				<label class="target wifi">
					<input type="checkbox" id="send-wifi"/>
					<span><b>{ t(ctx, "Only on Wi-Fi") }</b><small class="meta">{ t(ctx, "Files wait until the device is off mobile data. This goes by what the browser says: some browsers do not tell, and then everything is sent.") }</small></span>
				</label>
				<div class="field">
					<label for="send-tell">{ t(ctx, "Tell me when it is done") }</label>
					<select id="send-tell">
						<option value="all">{ t(ctx, "When everything has arrived, or something went wrong") }</option>
						<option value="problems">{ t(ctx, "Only when something went wrong") }</option>
						<option value="none">{ t(ctx, "Never") }</option>
					</select>
					<small class="meta">{ t(ctx, "One notice on this device for everything you sent, also with the screen off where the browser lets the app go on in the background (Android). On an iPhone files go only while this page is open.") }</small>
				</div>
				<p class="row form-actions"><button class="primary" type="submit" id="send-go" disabled>{ t(ctx, "Send") }</button></p>
				<p class="meta" id="send-bg" role="status" hidden>{ t(ctx, "This browser sends only while this page is open. Keep it open until everything is sent.") }</p>
				<ul class="plain send-list" id="send-list" aria-live="polite"></ul>
				<p class="row"><button type="button" class="link" id="send-clear" hidden>{ t(ctx, "Clear the finished ones") }</button></p>
				<p class="meta">{ t(ctx, "A file you chose waits in this browser until it is sent, also after the page is closed or the phone is switched off, and goes on by itself where it stopped. It is only ever sent as the person who chose it: after someone else signs in here, your files wait for you.") }</p>
				<p class="meta">{ t(ctx, "Files are sent as they are: nothing is made smaller, and the place where a photo was taken goes with it. Files up to {mb} MB can be sent.", "mb", fmt.Sprint(d.FileMB)) }</p>
			</form>
		}
	}
}
