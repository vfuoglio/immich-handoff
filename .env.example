IMMICH_BASE_URL=http://immich-server:2283
IMMICH_SOURCE_API_KEYS=key_for_user_A,key_for_user_B
IMMICH_DEST_API_KEY=key_for_family_account
# Must match the header value configured in the Immich workflow's "Trigger Webhook" step
WEBHOOK_SECRET=change-me-long-random
# Where Immich can reach this app; enables automatic workflow creation in each source account
PUBLIC_WEBHOOK_URL=http://immich-sync-console:8080/webhook/immich
# Optional
SHARE_TAG=share
INBOX_TAG=inbox
# Put on an original whose import was refused (copy sits in the destination trash); replaces SHARE_TAG
REFUSED_TAG=share-duplicate
INBOX_EXPIRY_DAYS=30
DELETE_FORCE=false
SWEEP_INTERVAL_HOURS=24
NOTIFY_URL=
DRY_RUN=false
