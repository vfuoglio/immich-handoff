# ---------- Required ----------
# A long random string. Immich sends it with every event so nobody else can trigger hand-overs.
# Generate one with: openssl rand -hex 24
WEBHOOK_SECRET=change-me-to-something-long-and-random

# A long random string (16+ characters). It encrypts the API keys the app keeps for people who join.
# Keep a copy somewhere safe: without it those keys cannot be read and people have to join again.
HANDOFF_STORE_KEY=change-me-too-this-one-is-also-secret

# Name of the Docker network Immich runs on (see "docker network ls")
IMMICH_NETWORK=immich_default

# ---------- Usually fine as they are ----------
# Immich, as seen from this container (service name of the Immich server on the shared network)
IMMICH_BASE_URL=http://immich-server:2283
# Where the Immich server can reach this app (not your browser)
PUBLIC_WEBHOOK_URL=http://immich-handoff:8080/webhook/immich
# Immich as your browser sees it; adds thumbnails of waiting photos to the page
# PUBLIC_IMMICH_URL=https://photos.example.com

# ---------- Fixed accounts: an admin supplies the API keys (instead of, or as well as, people joining themselves) ----------
# IMMICH_SOURCE_API_KEYS=key_for_person_1,key_for_person_2   # accounts that send photos
# IMMICH_DEST_API_KEY=key_for_the_receiving_account
# ROUTES_FILE=/routes.yaml                                    # several services; see routes.example.yaml
# ALLOW_JOIN=false                                            # true: people may add themselves to the fixed service

# ---------- Optional ----------
# ALBUM=                        # put handed-over photos in this album of the receiving account instead of tagging them inbox (key needs album.read, album.create, albumAsset.create)
# SHARE_TAG=share               # the tag people add to send a photo (fixed accounts)
# INBOX_TAG=inbox               # put on new photos in the receiving account
# REFUSED_TAG=share-duplicate   # put on an original that could not be handed over
# SENT_TAG=handed-over          # put on an original that was copied
# INBOX_EXPIRY_DAYS=30          # drop the inbox tag from unfiled photos after this many days
# HANDOFF_MODE=copy             # fixed accounts: copy keeps the sender's originals, move trashes them
# DELETE_FORCE=false            # true: delete originals permanently instead of moving them to the trash
# RECEIVER_DELETE=on            # off: receiver keys cannot move photos to their owner's trash, so copies cannot expire and a hand-over cannot be taken back. Read docs/settings.md first
# CARRY_DETAILS=on              # off: do not carry the archived state, description, rating and location
# QUIET_HOURS=                  # hand photos over only between these times, for example 01:00-06:00 (time zone: TZ); QUIET_LARGE_MB=200 makes only larger files wait
# TZ=UTC                        # the time zone of quiet hours and of the dates in tags, for example Europe/Rome
# BACKUP_EVERY=24h              # the app backs up its own data this often (1h or more), or off. See docs/operations.md
# BACKUP_KEEP=7                 # how many automatic backups to keep
# BACKUP_DIR=/data/backups      # where backups go; a second mounted folder survives losing the data volume
# HANDOFF_ADMIN_BACKUP_DOWNLOAD=true   # adds a Download backup button to the administrator's page; off unless true. Read docs/operations.md first
# NOTIFY_URL=                   # ntfy topic URL that receives a message when something needs attention
# PUSH=on                       # notifications on people's own devices (phone, computer); on when there is a way to reach you (see PUSH_CONTACT), off to switch them off
# PUSH_CONTACT=                 # mailto:you@example.com or an https address the push services can reach you at; else PUBLIC_APP_URL (https) is used
# FRAME_REFRESH=2m              # how often a frame (an album on a screen) looks at its album again; 5s to 1h
# NOTIFY_FILE=/notify.yaml      # more destinations (ntfy, JSON webhooks such as Home Assistant), each taking only some kinds. See notify.example.yaml
# PUBLIC_APP_URL=               # this app as your browser reaches it; adds a link to the page to each message
# DRY_RUN=false                 # true: log what would happen, change nothing
# CLEANUP_INTERVAL_MINUTES=15   # how often photos filed in an album lose the inbox tag (Immich sends no album event, so this is a timer; 0 = daily only)
# ALBUM_CHECK_MINUTES=15        # how often albums that senders linked to a service are looked at for new photos (0 = only with other passes)
# LOG_LEVEL=info                # debug: also log webhook payloads
