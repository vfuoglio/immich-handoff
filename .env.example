# ---------- Required ----------
# A long random string. Immich sends it with every event so nobody else can trigger hand-overs.
# Generate one with: openssl rand -hex 24
WEBHOOK_SECRET=change-me-to-something-long-and-random

# A long random string (16+ characters). It encrypts the API keys the app keeps for people who join.
# Keep a copy somewhere safe: without it those keys cannot be read and people have to join again.
HANDOFF_STORE_KEY=change-me-too-this-one-is-also-secret

# Name of the Docker network Immich runs on (see "docker network ls")
IMMICH_NETWORK=immich_default

# ---------- Usually fine as they are ----------
# Immich, as seen from this container (service name of the Immich server on the shared network)
IMMICH_BASE_URL=http://immich-server:2283
# Where the Immich server can reach this app (not your browser)
PUBLIC_WEBHOOK_URL=http://immich-handoff:8080/webhook/immich
# Immich as your browser sees it; adds thumbnails of waiting photos to the page
# PUBLIC_IMMICH_URL=https://photos.example.com

# ---------- Fixed accounts: an admin supplies the API keys (instead of, or as well as, people joining themselves) ----------
# IMMICH_SOURCE_API_KEYS=key_for_person_1,key_for_person_2   # accounts that send photos
# IMMICH_DEST_API_KEY=key_for_the_receiving_account
# ROUTES_FILE=/routes.yaml                                    # several services; see routes.example.yaml
# ALLOW_JOIN=false                                            # true: people may add themselves to the fixed service

# ---------- Optional ----------
# SHARE_TAG=share               # the tag people add to send a photo (fixed accounts)
# INBOX_TAG=inbox               # put on new photos in the receiving account
# REFUSED_TAG=share-duplicate   # put on an original that could not be handed over
# SENT_TAG=handed-over          # put on an original that was copied
# INBOX_EXPIRY_DAYS=30          # drop the inbox tag from unfiled photos after this many days
# HANDOFF_MODE=copy             # fixed accounts: copy keeps the sender's originals, move trashes them
# DELETE_FORCE=false            # true: delete originals permanently instead of moving them to the trash
# NOTIFY_URL=                   # ntfy-style URL that receives a message when something needs attention
# DRY_RUN=false                 # true: log what would happen, change nothing
# LOG_LEVEL=info                # debug: also log webhook payloads
